# %pip install -U langgraph requests

import os, re, json, requests
from typing import TypedDict, Dict, Any, List, Optional
from langgraph.graph import StateGraph, START, END
from langgraph.checkpoint.memory import MemorySaver

# --- config (edit these 5) ---
DATABRICKS_HOST     = os.getenv("DATABRICKS_HOST", "https://<your-workspace>")
DATABRICKS_TOKEN    = os.getenv("DATABRICKS_TOKEN", "<token>")
DATABRICKS_ENDPOINT = os.getenv("DATABRICKS_MODEL_ENDPOINT", "<endpoint-name>")
AZFUNC_BASE_URL     = os.getenv("AZFUNC_BASE_URL", "https://<your-azfunc>/api/sitedetails")
AZFUNC_KEY          = os.getenv("AZFUNC_KEY", "<func-key>")  # or pass as ?code=

# --- simple state ---
class State(TypedDict, total=False):
    messages: List[Dict[str, Any]]
    route: str                 # "tool" or "chat"
    name: Optional[str]

SYSTEM_PROMPT = "Be concise. If user asks for site details, use the tool and summarize."

def ensure_system(msgs: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    return msgs if (msgs and msgs[0].get("role") == "system") else [{"role":"system","content":SYSTEM_PROMPT}] + msgs

# --- tool: Azure Function ---
def site_details(name: str) -> str:
    try:
        h = {"User-Agent": "lg-min/1.0"}
        if AZFUNC_KEY: h["x-functions-key"] = AZFUNC_KEY
        r = requests.get(AZFUNC_BASE_URL, params={"name": name}, headers=h, timeout=10)
        return f"{r.status_code}: {r.text[:800]}"
    except Exception as e:
        return f"API error: {e}"

# --- chat: Databricks REST ---
def dbx_chat(messages: List[Dict[str, Any]]) -> str:
    url = f"{DATABRICKS_HOST.rstrip('/')}/api/2.0/serving-endpoints/{DATABRICKS_ENDPOINT}/invocations"
    h = {"Authorization": f"Bearer {DATABRICKS_TOKEN}", "Content-Type": "application/json"}
    body = {"messages": messages, "temperature": 0.2, "max_tokens": 512}
    r = requests.post(url, headers=h, json=body, timeout=15)
    r.raise_for_status()
    data = r.json()
    msg = (data.get("choices", [{}])[0].get("message", {}) or {}).get("content")
    if msg: return str(msg)
    for k in ("output_text","text","prediction","predictions"):
        if k in data: return data[k] if isinstance(data[k], str) else json.dumps(data[k])[:2000]
    return json.dumps(data)[:2000]

# --- router (super simple rule) ---
PATTERN = re.compile(r"(?:site\s*details|sitedetails).*(?:for|:)\s*(?P<name>[\w\s\-]+)", re.I)

def route_node(s: State) -> State:
    msgs = s.get("messages", [])
    if not msgs: return {"messages":[{"role":"system","content":SYSTEM_PROMPT}], "route":"chat"}
    last = msgs[-1]
    if last.get("role") == "user":
        m = PATTERN.search(last.get("content",""))
        if m: return {"route":"tool","name":m.group("name").strip()}
    return {"route":"chat"}

def tool_node(s: State) -> State:
    msgs = ensure_system(s.get("messages", []))
    name = s.get("name") or ""
    result = site_details(name)
    msgs.append({"role":"tool","content":f"site_details('{name}') -> {result}"})
    return {"messages": msgs}

def chat_node(s: State) -> State:
    msgs = ensure_system(s.get("messages", []))
    reply = dbx_chat(msgs)
    msgs.append({"role":"assistant","content":reply})
    return {"messages": msgs}

# --- graph ---
g = StateGraph(State)
g.add_node("route", route_node)
g.add_node("tool",  tool_node)
g.add_node("chat",  chat_node)
g.add_edge(START, "route")
g.add_conditional_edges("route", lambda s: s.get("route","chat"), {"tool":"tool","chat":"chat"})
g.add_edge("tool","chat")
g.add_edge("chat", END)
app = g.compile(checkpointer=MemorySaver())

# --- helper ---
def chat_once(thread_id: str, text: str) -> str:
    cfg = {"configurable": {"thread_id": thread_id}}
    out = app.invoke({"messages":[{"role":"user","content":text}]}, config=cfg)
    return out["messages"][-1]["content"]

