import express from "express";
import cors from "cors";
import fetch from "node-fetch";

const app = express();
app.use(cors()); // <-- solves browser CORS by allowing your frontend to call this server
app.use(express.json({ limit: "2mb" }));

// -------------------- CONFIG --------------------
const TENANT_ID = process.env.TENANT_ID || "<TENANT_ID>";
const CLIENT_ID = process.env.CLIENT_ID || "<CLIENT_ID>";
const CLIENT_SECRET = process.env.CLIENT_SECRET || "<CLIENT_SECRET>";

const DATABRICKS_HOST =
  process.env.DATABRICKS_HOST || "https://adb-1355704782079007.7.azuredatabricks.net";
const ENDPOINT_NAME = process.env.ENDPOINT_NAME || "custbrief__serving_endpoint";

const AAD_TOKEN_URL = `https://login.microsoftonline.com/${TENANT_ID}/oauth2/v2.0/token`;
const DBX_SCOPE = "2ff814a6-3304-4ab8-85cb-cd0e6f879c1d/.default"; // Azure Databricks resource scope
// ------------------------------------------------

async function getDatabricksAccessToken() {
  if ([TENANT_ID, CLIENT_ID, CLIENT_SECRET].some(v => !v || v.startsWith("<"))) {
    throw new Error("Missing TENANT_ID / CLIENT_ID / CLIENT_SECRET. Set env vars or replace placeholders.");
  }

  const body = new URLSearchParams({
    client_id: CLIENT_ID,
    client_secret: CLIENT_SECRET,
    grant_type: "client_credentials",
    scope: DBX_SCOPE,
  });

  const resp = await fetch(AAD_TOKEN_URL, {
    method: "POST",
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    body,
  });

  const data = await resp.json();
  if (!resp.ok) {
    throw new Error(`Token error (${resp.status}): ${JSON.stringify(data)}`);
  }
  if (!data.access_token) throw new Error(`No access_token in response: ${JSON.stringify(data)}`);
  return data.access_token;
}

// ----------- Backend endpoint your browser calls -----------
app.post("/api/invoke", async (req, res) => {
  try {
    const accessToken = await getDatabricksAccessToken();

    const url = `${DATABRICKS_HOST}/serving-endpoints/${ENDPOINT_NAME}/invocations`;
    const dbxResp = await fetch(url, {
      method: "POST",
      headers: {
        Authorization: `Bearer ${accessToken}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify(req.body),
    });

    const text = await dbxResp.text();
    // Pass through status and body from Databricks
    res.status(dbxResp.status);
    res.setHeader("Content-Type", dbxResp.headers.get("content-type") || "application/json");
    return res.send(text);
  } catch (e) {
    return res.status(500).json({ error: e.message });
  }
});

// ----------- Simple browser page (no build tools) -----------
app.get("/", (req, res) => {
  res.type("html").send(`
<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Databricks Endpoint - Browser Call (CORS-safe)</title>
  <style>
    body { font-family: system-ui, Arial; margin: 20px; }
    textarea { width: 100%; height: 220px; }
    pre { background: #111; color: #eee; padding: 12px; overflow: auto; }
    button { padding: 10px 14px; cursor: pointer; }
  </style>
</head>
<body>
  <h2>Invoke Databricks Serving Endpoint (via proxy)</h2>

  <p>Edit payload and click <b>Send</b>.</p>

  <textarea id="payload"></textarea>
  <br/><br/>
  <button onclick="send()">Send</button>

  <h3>Response</h3>
  <pre id="out"></pre>

  <script>
    // Default payload matches your endpoint format
    const defaultPayload = {
      dataframe_split: {
        columns: ["site_id", "sf_feed", "analytic_data", "messages"],
        data: [
          [8391413, "", "", [{ role: "user", content: "site id=8391413" }]]
        ]
      }
    };

    document.getElementById("payload").value = JSON.stringify(defaultPayload, null, 2);

    async function send() {
      const out = document.getElementById("out");
      out.textContent = "Calling /api/invoke ...";

      let bodyObj;
      try {
        bodyObj = JSON.parse(document.getElementById("payload").value);
      } catch (e) {
        out.textContent = "Invalid JSON in payload: " + e.message;
        return;
      }

      try {
        const resp = await fetch("/api/invoke", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(bodyObj),
        });

        const text = await resp.text();
        out.textContent = "HTTP " + resp.status + "\\n\\n" + text;
      } catch (e) {
        out.textContent = "Browser error: " + e.message;
      }
    }
  </script>
</body>
</html>
  `);
});

const port = process.env.PORT || 3000;
app.listen(port, () => console.log(`✅ Open http://localhost:${port}`));
