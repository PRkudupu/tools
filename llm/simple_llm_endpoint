import operator
import json
from typing import TypedDict, Annotated, List, Any

# Assuming these are available in your environment, otherwise replace/install
# NOTE: While this LLM class is likely from LangChain, 
# its usage is limited to a function call, making the rest of the code pure LangGraph.
from langchain_community.chat_models import ChatDatabricks 
from langgraph.graph import StateGraph, START, END

# --- Define the State object (TypedDict for LangGraph) ---
class SiteState(TypedDict):
    """
    Represents the state of our graph.
    - user_input: The user's initial input string.
    - llm_output: The raw response from the LLM.
    """
    user_input: str
    llm_output: Annotated[Any, operator.setitem] # Use operator.setitem to replace the output

# --- The call_llm Node Function (Minimal LangChain usage) ---
def call_llm(state: SiteState) -> SiteState:
    """
    The node function that formats the prompt and calls the LLM.
    """
    # 1. Define the LLM (using the existing configuration)
    llm = ChatDatabricks(
        endpoint="databricks-gpt-oss-20b",
        temperature=1.0,
        max_tokens=768,
    )

    # 2. Manual Prompt Formatting (Replacing ChatPromptTemplate)
    system_message = "You are a smart assistant who has good knowledge about ecolabs."
    human_message = state["user_input"]
    
    # Simple message list format expected by many chat LLMs
    messages = [
        ("system", system_message),
        ("human", human_message),
    ]

    # 3. Direct LLM Call (Replacing LCEL pipe)
    # The ChatDatabricks class still handles formatting this into the API call
    response = llm.invoke(messages)

    # 4. Return the updated state
    return {"llm_output": response.content} # Return just the string content

# --- Build graph ---

workflow = StateGraph(SiteState)

# Add the node
workflow.add_node("call_llm", call_llm)

# Define the sequence of steps
workflow.add_edge(START, "call_llm")
workflow.add_edge("call_llm", END)

# Compile the graph
graph = workflow.compile()

# --- MLflow Registration/Logging ---

import mlflow
from mlflow.langchain import save_model # Still necessary as LangGraph is LCEL-compatible

# Define artifact path for MLflow
artifact_path = "langgraph_model"
model_name = "LangGraph_EcoLabs_Assistant"

# Start an MLflow run
with mlflow.start_run() as run:
    # Use mlflow.langchain.save_model to correctly log the graph. 
    # LangGraph objects are compatible with the mlflow.langchain flavor.
    mlflow.langchain.save_model(
        lc_model=graph,
        path=artifact_path,
        # The LangGraph needs a sample input to correctly infer the schema for logging
        sample_input={"user_input": "What are the core products of Ecolab?"}
    )

    # Register the model to the MLflow Model Registry
    mlflow.register_model(
        model_uri=f"runs:/{run.info.run_id}/{artifact_path}",
        name=model_name,
        tags={"graph_type": "LangGraph"}
    )

print(f"✅ Graph compiled and registered as MLflow model '{model_name}'.")
