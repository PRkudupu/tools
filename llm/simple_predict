class QAState(dict): pass

prompt = ChatPromptTemplate.from_messages([
    ("system", "You are concise."),
    ("user", "{question}")
])

model = ChatDatabricks(endpoint="databricks-gpt-oss-20b",
                       extra_params={"temperature": 0.3, "max_tokens": 600})

def generate(state: QAState) -> QAState:
    res = model.invoke(prompt.format_messages(question=state["question"]))
    state["answer"] = res.content
    return state

class QAGraph:
    def __init__(self):
        g = StateGraph(QAState)
        g.add_node("generate", generate)
        g.set_entry_point("generate")
        g.add_edge("generate", END)
        self.graph = g.compile()

    def predict(self, model_input: dict) -> pd.Series:
        qs = model_input["question"]
        if isinstance(qs, str):
            qs = [qs]
        answers = [self.graph.invoke(QAState(question=q))["answer"] for q in qs]
        return pd.Series(answers, name="answer")

# === Run this ===
qa = QAGraph()
out1 = qa.predict({"question": "What is the capital of France?"})
print(out1)

# --------- MLflow PyFunc wrapper ----------
class LLMGraphModel(mlflow.pyfunc.PythonModel):
    def load_context(self, context):
        # Rebuild or load the graph at serve-time
        self.graph = build_graph()

    def predict(self, context, model_input):
        """
        model_input: either a plain string, or a dict like {"text": "..."}
        returns: string (the assistant's last message)
        """
        if isinstance(model_input, dict):
            text = model_input.get("text", "")
        else:
            text = str(model_input)

        result = self.graph.invoke({"messages": [HumanMessage(content=text)]})
        # last message from the graph is the LLM response object; return its content field
        last = result["messages"][-1]
        # LangChain chat message objects store text at .content
        return str(getattr(last, "content", last))


