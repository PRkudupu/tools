import re

def extract_site_id(messages):
    """
    Prefer a number that appears after 'site_id' or 'site'.
    Falls back to a bare number only if it's the whole message.
    Returns None if nothing usable is found.
    """
    key_pat = re.compile(r"\b(?:site[_\s-]*id|site)\b\D*?(\d{2,})", re.I)
    bare_pat = re.compile(r"^\s*(\d{2,})\s*$")

    for msg in reversed(messages):
        if msg.get("role") != "user":
            continue
        text = msg.get("content", "")
        m = key_pat.search(text)
        if m:
            return m.group(1)
        # fallback: message is just a number like "12345"
        m2 = bare_pat.search(text)
        if m2:
            return m2.group(1)
    return None

