# === MINIMAL: Log + Register Model with Signature (No Warnings) ===

import mlflow
import numpy as np
from sklearn.linear_model import LogisticRegression
from mlflow.models import infer_signature

# --- 1. Train tiny model ---
X = np.array([[1], [2], [3], [4]])
y = np.array([0, 0, 1, 1])
model = LogisticRegression().fit(X, y)

# --- 2. Infer signature (input + output example) ---
signature = infer_signature(X, model.predict(X))

# --- 3. Log & Register in Unity Catalog ---
mlflow.set_experiment("/Users/your@email.com/simple-model-exp")  # Change email

with mlflow.start_run():
    mlflow.sklearn.log_model(
        sk_model=model,
        artifact_path="model",
        signature=signature,           # This fixes the warning
        input_example=X[:1]            # Optional but recommended
    )
    
    model_uri = f"runs:/{mlflow.active_run().info.run_id}/model"
    registered = mlflow.register_model(model_uri, "main.default.simple_logreg")
    
    print(f"Registered: {registered.name} v{registered.version}")
