from langgraph.graph import StateGraph, START, END
from langgraph.graph.message import add_messages
from typing import TypedDict, Annotated, Literal, List

class State(TypedDict):
    messages: Annotated[List[tuple], add_messages]
    chat_type: Literal["RAG", "SIMPLE"]
    result: str

def decide_chat_type(state: State) -> State:
    # toy example: if user message contains "rag" then use RAG
    user_msg = state["messages"][-1][1].lower()
    state["chat_type"] = "RAG" if "rag" in user_msg else "SIMPLE"
    return state

def call_llm_simple(state: State) -> State:
    state["result"] = "Simple answer"
    return state

def call_llm_rag(state: State) -> State:
    state["result"] = "RAG answer (with context)"
    return state

def route_from_chat_type(state: State) -> str:
    return state.get("chat_type", "SIMPLE")

g = StateGraph(State, channels={"messages": add_messages})
g.add_node("decide_chat_type", decide_chat_type)
g.add_node("call_llm_simple", call_llm_simple)
g.add_node("call_llm_rag", call_llm_rag)

g.add_edge(START, "decide_chat_type")

g.add_conditional_edges(
    "decide_chat_type",
    route_from_chat_type,
    {
        "SIMPLE": "call_llm_simple",
        "RAG": "call_llm_rag",
    },
)

g.add_edge("call_llm_simple", END)
g.add_edge("call_llm_rag", END)

graph = g.compile()


