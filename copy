from typing import TypedDict, Annotated, Literal, List, Dict, Any
from langgraph.graph import StateGraph, START, END
from langgraph.graph.message import add_messages
from json import dumps

# ---------- State ----------

class State(TypedDict):
    messages: Annotated[List[tuple], add_messages]
    site_id: str
    sf_feed: Dict[str, Any]
    analytic_data: Dict[str, Any]
    chat_type: Literal["SIMPLE", "RAG"]
    result: str


# ---------- Router (fast, runs at START) ----------

def route_from_chat_type(state: State) -> str:
    """
    Decide SIMPLE vs RAG directly from the incoming state.

    NOTE: LangGraph treats this as a pure function, so keep it cheap.
    Setting chat_type here is OK but don't do any network calls.
    """
    msgs = _to_pairs(state.get("messages", []))
    chat_type = "RAG" if extract_site_id(msgs) else "SIMPLE"

    # store for downstream nodes / logging
    state["chat_type"] = chat_type
    return chat_type


# ---------- Nodes ----------

def call_llm_simple(state: State) -> State:
    """
    Lightweight SIMPLE mode. No analytics, no big JSON dumps.
    """
    try:
        msgs = _to_pairs(state.get("messages", []))

        # Just basic system prompt
        sys_prompt = SIMPLE_PROMPT

        if not msgs or msgs[0][0] != "system":
            msgs = [("system", sys_prompt)] + msgs

        ai = chat.invoke(msgs)
        text = getattr(ai, "content", str(ai))

        state["result"] = text
        state["messages"] = [("assistant", text)]
        return state
    except Exception as e:
        print("There was an error (simple):", e)
        state["result"] = str(e)
        state["messages"] = [("assistant", f"There was an error {e}")]
        return state


def call_llm_rag(state: State) -> State:
    """
    RAG mode: assumes sf_feed & analytic_data already populated.
    """
    try:
        site_id       = state.get("site_id", "")
        sf_feed       = state.get("sf_feed", {})
        analytic_data = state.get("analytic_data", {})

        msgs = _to_pairs(state.get("messages", []))

        # faster, more compact JSON (no pretty indent)
        feed_text = dumps(sf_feed, ensure_ascii=False, separators=(",", ":"))

        sys_prompt = DEFAULT_SYSTEM_PROMPT.format(
            site_id=site_id,
            sf_feed=feed_text,
            analytic_data=analytic_data,
        )

        if not msgs or msgs[0][0] != "system":
            msgs = [("system", sys_prompt)] + msgs

        ai = chat.invoke(msgs)
        text = getattr(ai, "content", str(ai))

        state["result"] = text
        state["messages"] = [("assistant", text)]
        return state
    except Exception as e:
        print("There was an error (rag):", e)
        state["result"] = str(e)
        state["messages"] = [("assistant", f"There was an error {e}")]
        return state


def get_analytic_data(state: State) -> State:
    # your existing implementation
    return get_analytic_data_impl(state)


def get_salesforce_feed(state: State) -> State:
    # your existing implementation
    return get_salesforce_feed_impl(state)


# ---------- Graph ----------

def build_graph():
    g = StateGraph(State, channels={"messages": add_messages})

    # Nodes
    g.add_node("get_analytic_data", get_analytic_data)
    g.add_node("get_salesforce_feed", get_salesforce_feed)
    g.add_node("call_llm_simple", call_llm_simple)
    g.add_node("call_llm_rag", call_llm_rag)

    # Conditional routing directly from START:
    # SIMPLE  -> call_llm_simple
    # RAG     -> get_analytic_data & get_salesforce_feed (in parallel) -> call_llm_rag
    g.add_conditional_edges(
        START,
        route_from_chat_type,
        {
            "SIMPLE": "call_llm_simple",
            "RAG": "get_analytic_data",  # entry to RAG branch
        },
    )

    # RAG branch fan-out & merge
    g.add_edge("get_analytic_data", "get_salesforce_feed")
    g.add_edge("get_salesforce_feed", "call_llm_rag")

    # Both paths end here
    g.add_edge("call_llm_simple", END)
    g.add_edge("call_llm_rag", END)

    return g.compile()
