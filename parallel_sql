from concurrent.futures import ThreadPoolExecutor, as_completed, TimeoutError
from typing import Dict, Any
import logging

# Configure logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')

# Assuming 'spark' is a pyspark.sql.SparkSession instance available in the scope.
# If not, it should be initialized or passed as a parameter.

def execute_query(name: str, job: str) -> tuple[str, Any]:
    """
    Execute a Spark SQL query and return the results, handling exceptions.
    
    :param name: The name/key for the query.
    :param job: A SQL query string.
    :return: Tuple of (name, result) where result is the query output or error message.
    """
    try:
        result = spark.sql(job).collect()  # Collect results (consider alternatives for large data)
        return name, result
    except Exception as e:
        logging.error(f"Error executing query '{name}': {str(e)}")
        return name, f"error: {str(e)}"

def process_queries(q: Dict[str, str], state: Dict[str, Any]) -> Dict[str, Any]:
    """
    Process multiple Spark SQL queries in parallel and update the state.
    
    :param q: Dictionary of query names and their SQL strings.
    :param state: Dictionary to store results and system messages.
    :return: Updated state dictionary.
    """
    if not q:
        logging.warning("No queries to execute in 'q'.")
        state["system_message"] = "No queries to process"
        return state

    analytic_data: Dict[str, Any] = {}
    num_jobs = len(q)
    max_workers = min(max(1, num_jobs), 32)  # Dynamic worker cap based on job count

    with ThreadPoolExecutor(max_workers=max_workers) as pool:
        futures = [pool.submit(execute_query, name, job) for name, job in q.items()]
        for fut in as_completed(futures):
            try:
                name, result = fut.result(timeout=300)  # 5-minute timeout per query
                analytic_data[name] = result
            except TimeoutError:
                logging.error(f"Timeout for query '{name}' after 300 seconds.")
                analytic_data[name] = "error: Timeout after 300 seconds"
            except Exception as e:
                logging.error(f"Unexpected error for query '{name}': {str(e)}")
                analytic_data[name] = f"error: {str(e)}"

    # Update state
    state["analytic_data"] = analytic_data
    state["system_message"] = "Analytics complete"
    logging.info("Analytics complete")

    return state

