# Parallel SELECTs in a Databricks Spark notebook (Serverless-friendly)
from concurrent.futures import ThreadPoolExecutor, as_completed
from pyspark.storagelevel import StorageLevel

site_id = "12345"  # <-- your value

queries = [
    ("site_account_mapping",  f"SELECT * FROM cbt.site_account_mapping        WHERE siteid='{site_id}'"),
    ("mpl_spl_penetration",   f"SELECT * FROM cbt.mpl_spl_penetration         WHERE siteid='{site_id}'"),
    ("last_interaction",      f"SELECT * FROM cbt.last_interaction            WHERE siteid='{site_id}'"),
    ("price_change",          f"SELECT * FROM cbt.price_change                WHERE siteid='{site_id}'"),
    ("solution_price_change", f"SELECT * FROM cbt.solution_sales_change       WHERE siteid='{site_id}'"),
    ("sales_wrt_last_year",   f"SELECT * FROM cbt.sales_wrt_last_year         WHERE siteid='{site_id}'"),
    ("percentage_solution_sales_change",
                              f"SELECT * FROM cbt.percentage_solution_sales_change WHERE siteid='{site_id}'"),
    ("asset_location",        f"SELECT * FROM cbt.asset_location              WHERE siteid='{site_id}'"),
    ("sales_info_mtd",        f"SELECT * FROM cbt.sales_info_mtd              WHERE siteid='{site_id}'"),
    ("sales_info_ytd_r12",    f"SELECT * FROM cbt.sales_info_ytd_r12          WHERE siteid='{site_id}'"),
]

# Make sure concurrent jobs are fairly scheduled (Databricks default is FAIR, but set explicitly)
spark.conf.set("spark.scheduler.mode", "FAIR")

def run_query(name: str, sql_text: str):
    try:
        # Optional: put each job in its own fair-scheduler pool to avoid starvation
        spark.sparkContext.setLocalProperty("spark.scheduler.pool", name)

        df = spark.sql(sql_text).persist(StorageLevel.MEMORY_AND_DISK)
        df.count()  # ACTION -> materialize; without this Spark is lazy and won't parallelize
        df.createOrReplaceTempView(name)  # handy for downstream SQL
        return name, df, None
    except Exception as e:
        return name, None, str(e)
    finally:
        spark.sparkContext.setLocalProperty("spark.scheduler.pool", None)

max_workers = min(len(queries), 8)  # tune for your warehouse/cluster size
results, errors = {}, {}

with ThreadPoolExecutor(max_workers=max_workers) as pool:
    futs = [pool.submit(run_query, n, s) for n, s in queries]
    for f in as_completed(futs):
        name, df, err = f.result()
        if err:
            errors[name] = err
        else:
            results[name] = df

print("Materialized:", sorted(results.keys()))
if errors:
    print("Errors:")
    for k, v in errors.items():
        print(f"  - {k}: {v}")
