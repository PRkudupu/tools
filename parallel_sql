from pyspark.sql import SparkSession
from concurrent.futures import ThreadPoolExecutor

# Initialize Spark session
spark = SparkSession.builder.appName("ParallelQueries").getOrCreate()

# List of queries
queries = [
    "SELECT * FROM cbt.site_account_mapping WHERE siteid='site_id'",
    "SELECT * FROM cbt.mpl_spl_penetration WHERE siteid='site_id'",
    "SELECT * FROM cbt.last_interaction WHERE siteid='site_id'",
    "SELECT * FROM cbt.interaction WHERE siteid='site_id'",
    "SELECT * FROM cbt.solution_sales_change WHERE siteid='site_id'",
    "SELECT * FROM cbt.sales_wrt_last_year WHERE siteid='site_id'",
    "SELECT * FROM cbt.percentage_solution_sales_change WHERE siteid='site_id'",
    "SELECT * FROM cbt.asset_location WHERE siteid='site_id'",
    "SELECT * FROM cbt.sales_info_mtd WHERE siteid='site_id'",
    "SELECT * FROM cbt.sales_info_ytd_r12 WHERE siteid='site_id'"
]

# Function to execute a single query
def run_query(query):
    return spark.sql(query)

# Run queries in parallel
with ThreadPoolExecutor(max_workers=len(queries)) as executor:
    results = list(executor.map(run_query, queries))

# Optionally, collect and process results
for i, result in enumerate(results):
    result.show()
