# =======================
# Build LangGraph
# =======================
def build_graph(endpoint_name: str):
    chat = ChatDatabricks(endpoint=endpoint_name, temperature=0.0, max_tokens=256)

    def get_salesforce_feed(state: State) -> dict:
        try:
            site_id = state.get("site_id", "")
            sf = load_salesforce_feed(site_id)
        except Exception as e:
            print("SF exception:", e)
            sf = {"error": "Exception"}
        # return partial-state (do NOT mutate state in place)
        return {"sf_feed": sf}

    def llm_call(state: State) -> dict:
        site_id = state.get("site_id", "")
        sf_feed = state.get("sf_feed", {})
        msgs    = _to_pairs(state.get("messages", []))

        # format the STRING prompt with sf_feed & site_id
        feed_text = json.dumps(sf_feed, ensure_ascii=False, indent=2)
        sys_prompt = GLOBAL_PROMPT.format(site_id=site_id, sf_feed=feed_text)

        # prepend system prompt if first message isn't system
        if not msgs or msgs[0][0] != "system":
            msgs = [("system", sys_prompt)] + msgs

        ai = chat.invoke(msgs)
        text = getattr(ai, "content", str(ai))
        return {"messages": [("assistant", text)], "result": text}

    g = StateGraph(State, channels={"messages": add_messages})
    g.add_node("get_salesforce_feed", get_salesforce_feed)
    g.add_node("llm_call", llm_call)

    g.add_edge(START, "get_salesforce_feed")
    g.add_edge("get_salesforce_feed", "llm_call")
    g.add_edge("llm_call", END)
    return g.compile()


# =======================
# MLflow PyFunc wrapper
# =======================
class LangGraphPyfunc(mlflow.pyfunc.PythonModel):
    def __init__(self, endpoint_name: str):
        self.endpoint_name = endpoint_name
        self.graph = None

    def load_context(self, context):
        _require_dbx_creds()
        self.graph = build_graph(self.endpoint_name)

    def predict(self, context, model_input: pd.DataFrame) -> pd.DataFrame:
        # Lazy init (lets you test predict locally too)
        if self.graph is None:
            _require_dbx_creds()
            self.graph = build_graph(self.endpoint_name)
        results: List[str] = []
        for msgs in model_input["messages"]:
            out = self.graph.invoke({"messages": msgs, "site_id": model_input.get("site_id", [""])[0], "sf_feed": {}, "result": ""})
            results.append(out["result"])
        return pd.DataFrame({"result": results})


