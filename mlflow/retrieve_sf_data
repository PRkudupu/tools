# =======================
# Credential guard
# =======================
def _require_dbx_creds():
    if not (
        os.environ.get("DATABRICKS_HOST") and os.environ.get("DATABRICKS_TOKEN")
    ) and not os.environ.get("DATABRICKS_CONFIG_PROFILE"):
        raise RuntimeError(
            "Databricks credentials not found. Set DATABRICKS_HOST and DATABRICKS_TOKEN "
            "(or DATABRICKS_CONFIG_PROFILE) in the serving environment."
        )


# =======================
# State schema
# =======================
class State(TypedDict):
    messages: Annotated[list, add_messages]   # chat history reducer
    site_id: str
    sf_feed: dict
    result: str


# =======================
# Utilities
# =======================
def _to_pairs(raw) -> List[Tuple[str, str]]:
    """Normalize messages to list[(role, content)]."""
    if isinstance(raw, str):
        return [("user", raw)]
    out: List[Tuple[str, str]] = []
    for m in raw or []:
        if isinstance(m, tuple) and len(m) >= 2:
            out.append((str(m[0]).lower(), str(m[1])))
        elif isinstance(m, dict) and "content" in m:
            role = str(m.get("role", m.get("type", "user"))).lower()
            out.append((role, str(m["content"])))
        else:
            role = getattr(m, "type", getattr(m, "role", "user"))
            content = getattr(m, "content", None)
            out.append((str(role).lower(), str(content) if content is not None else str(m)))
    return out


