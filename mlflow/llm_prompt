GLOBAL_PROMPT = os.getenv("SYSTEM_PROMPT", DEFAULT_SYSTEM_PROMPT)  # <<< ADD/EDIT PROMPT VIA ENV HERE >>>

# =======================
# Utilities
# =======================
def _require_dbx_creds():
    if not (
        os.environ.get("DATABRICKS_HOST") and os.environ.get("DATABRICKS_TOKEN")
    ) and not os.environ.get("DATABRICKS_CONFIG_PROFILE"):
        raise RuntimeError(
            "Databricks credentials not found. Set DATABRICKS_HOST and DATABRICKS_TOKEN "
            "OR DATABRICKS_CONFIG_PROFILE in the serving environment."
        )

def _as_text(x) -> str:
    if x is None: return ""
    if isinstance(x, (str, int, float, bool)): return str(x)
    try: return json.dumps(x, ensure_ascii=False)
    except Exception: return str(x)

def _extract_text(ai_obj) -> str:
    return _as_text(getattr(ai_obj, "content", ai_obj))

# =======================
# State (NO Annotated)
# =======================
class State(TypedDict):
    messages: List[BaseMessage]
    result: Optional[str]

def _to_messages(raw) -> List[BaseMessage]:
    """
    Normalize to List[BaseMessage].
    You can also pass a system message as the FIRST item in 'messages'
    to set a per-request prompt:
      [{"role":"system","content":"<your prompt>"},
       {"role":"user","content":"hi"}]
    """
    if isinstance(raw, str):
        return [HumanMessage(content=_as_text(raw))]

    out: List[BaseMessage] = []
    for m in raw or []:
        if isinstance(m, BaseMessage):
            m.content = _as_text(m.content); out.append(m); continue

        if isinstance(m, tuple) and len(m) >= 2:
            role, content = str(m[0]).lower(), m[1]
        elif isinstance(m, dict) and "content" in m:
            role = str(m.get("role", m.get("type", "user"))).lower()
            content = m["content"]
        else:
            role = str(getattr(m, "role", getattr(m, "type", "user"))).lower()
            content = getattr(m, "content", m)

        content_s = _as_text(content)
        if role == "system":
            out.append(SystemMessage(content=content_s))
        elif role in ("ai", "assistant"):
            out.append(AIMessage(content=content_s))
        else:
            out.append(HumanMessage(content=content_s))
    return out

# =======================
# Build LangGraph
# =======================
def build_graph(endpoint_name: str):
    chat = ChatDatabricks(endpoint=endpoint_name, temperature=0.0, max_tokens=256)

    def llm_call(state: State) -> State:
        msgs = _to_messages(state.get("messages", []))

        # If the first message is not system, prepend the GLOBAL prompt
        # (per-request system message takes precedence if already provided)
        if not msgs or not isinstance(msgs[0], SystemMessage):
            msgs = [SystemMessage(content=_as_text(GLOBAL_PROMPT))] + msgs  # <<< GLOBAL PROMPT APPLIED HERE >>>

        ai = chat.invoke(msgs)
        text = _extract_text(ai)
        return {"messages": [AIMessage(content=text)], "result": text}

    g = StateGraph(State, channels={"messages": add_messages})  # reducer mapping (no Annotated)
    g.add_node("llm_call", llm_call)
    g.add_edge(START, "llm_call")
    g.add_edge("llm_call", END)
    return g.compile()

