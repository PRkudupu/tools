# DBTITLE 1,Define variables
import os
from operator import itemgetter
from databricks_langchain import ChatDatabricks
from databricks_langchain import DatabricksVectorSearch
from langchain.schema.runnable import RunnableLambda
from langchain_core.prompts import ChatPromptTemplate


# VS endpoint & index
vectorSearchEndpointName = "psvectorsearch"
indexName                = "insurance.rag.insuranceindex"


# Models
embeddingModelName       = "databricks-bge-large-en"
llmModelName             = "databricks-meta-llama-3-1-70b-instruct"


# Databricks endpoint & token
host = "https://" + spark.conf.get("spark.databricks.workspaceUrl")

accessToken = "<Add personal access token>"

# COMMAND ----------

# MAGIC %md
# MAGIC ### 3.B. Create Vector Search Retriever

# COMMAND ----------

# DBTITLE 1,Create method to return Vector Search retriever
def getVectorSearchRetriever( persist_dir: str = None ):
    
    # Set host and token as environment variables
    os.environ["DATABRICKS_HOST"]  = host
    os.environ["DATABRICKS_TOKEN"] = accessToken

    # Create retriever
    vectorStore = DatabricksVectorSearch(
                                            endpoint   = vectorSearchEndpointName,
                                            index_name = indexName
                                        )
    
    return vectorStore.as_retriever( search_kwargs = {"k": 3} )     # Return 3 chunks


# Format the chunks returned by retriever for the prompt
def formatChunks(chunks):    
    chunkContents = [f"{chunk.page_content}\n\n" for chunk in chunks]    
    return "".join(chunkContents)


# COMMAND ----------

# MAGIC %md
# MAGIC ### 3.C. Create and Test RAG Chain using LangChain

# COMMAND ----------

# DBTITLE 1,Create RAG chain using LangChain
# Create system message template to define behavior
systemMessageTemplate = """

You are an assistant for health insurance. If you don't know the answer, just say so. Keep the answer as concise as possible.

Use the following pieces of context to answer the question:
{context}

"""

# Create prompt (input) message
prompt = ChatPromptTemplate.from_messages (
            [  
                ("system", systemMessageTemplate),    # System message to define behavior

                ("user", "{question}")                # User question
            ]
)

# Define model
model = ChatDatabricks(
                         endpoint     = llmModelName,

                         extra_params = { "temperature": 0.3, "max_tokens": 600 }
                      )

# Method to return content of most recent message
def extractUserQuery(chatMessagesArray):
    return chatMessagesArray[-1]["content"]

# Define RAG Chain
chain = (
            {
                # Set question
                "question": itemgetter("messages") 
                                | RunnableLambda(extractUserQuery),
                
                # Set context
                "context": itemgetter("messages")
                            | RunnableLambda(extractUserQuery)
                            | getVectorSearchRetriever()
                            | RunnableLambda(formatChunks)
            }
            | prompt
            | model
        ) 

# COMMAND ----------

# DBTITLE 1,Test RAG chain
# Define message
messages = {"messages": [{
                            "role": "user",
                            "content": "How many days are covered under pre-hospitalization?"
                        }]
           }

# Invoke chain
answer = chain.invoke(messages)

# Print answer
print(answer.content) 

# COMMAND ----------

