# DBTITLE 1,Register model
from mlflow.models import infer_signature
import mlflow
import langchain
import langchain_core
import langchain_community

# Set model name
mlflow.set_registry_uri("databricks-uc")
model_name = "insurance.rag.InsuranceModel"

# Register model 
with mlflow.start_run(run_name = "InsuranceModelRun") as run:

    signature = infer_signature(messages, answer.content)

    model_info = mlflow.langchain.log_model(
                                                chain,
