import os
import logging
from concurrent.futures import ThreadPoolExecutor, as_completed
from typing import Dict, Any
import pyspark.sql.functions as F  # For potential Spark DataFrame ops post-query
from pyspark.sql import SparkSession

# Optional: For direct SQL Warehouse integration (install via %pip install databricks-sql-connector)
try:
    from databricks import sql
    SQL_WAREHOUSE_ENABLED = True
except ImportError:
    SQL_WAREHOUSE_ENABLED = False
    logging.warning("databricks-sql-connector not available; falling back to spark.sql()")

# MLOps: Enable MLflow for logging (Databricks auto-configures)
import mlflow

# Set active catalog in Spark SQL (Databricks Unity Catalog)
spark = SparkSession.builder.getOrCreate()
spark.sql("USE CATALOG industrial-data-science")

# Define SQL queries for various analytic tables, filtered by site ID
def get_queries(site_id: str) -> Dict[str, str]:
    return {
        "site_account_mapping": f"SELECT * FROM cbt.site_account_mapping WHERE siteid='{site_id}'",  # Site account mapping data
        "mpl_sql_penetration": f"SELECT * FROM cbt.mpl_sql_penetration WHERE siteid='{site_id}'"  # MPL/SQL penetration data
    }

# Analytic data function (placeholder; extend for joins/aggregations if needed)
def process_analytic_data(df: Any, name: str) -> Dict[str, Any]:
    """
    Process Spark DataFrame or SQL result into dict.
    In prod, add ML inference here (e.g., via MLflow model load).
    """
    if hasattr(df, 'collect'):  # Spark DataFrame
        rows = df.collect()
        return {name: [row.asDict() for row in rows]}
    else:  # SQL Warehouse result (list of dicts)
        return {name: df}

# Execute a single Spark SQL query and return results, handling exceptions
def execute_spark_query(query: str) -> Dict[str, Any]:
    try:
        result = spark.sql(query).collect()
        return {'data': [row.asDict() for row in result]}
    except Exception as e:
        logging.error(f"Spark SQL error: {str(e)}")
        return {'error': str(e)}

# Optional: Execute via Databricks SQL Warehouse (serverless, parallel-friendly)
def execute_sql_warehouse_query(query: str, warehouse_hostname: str, http_path: str, token: str) -> Dict[str, Any]:
    if not SQL_WAREHOUSE_ENABLED:
        raise ImportError("databricks-sql-connector required for SQL Warehouse")
    try:
        with sql.connect(
            server_hostname=warehouse_hostname,
            http_path=http_path,
            access_token=token
        ) as conn:
            with conn.cursor() as cursor:
                cursor.execute(query)
                rows = cursor.fetchall()
                columns = [desc[0] for desc in cursor.description]
                return {'data': [dict(zip(columns, row)) for row in rows]}
    except Exception as e:
        logging.error(f"SQL Warehouse error: {str(e)}")
        return {'error': str(e)}

# Main parallel execution function
def run_parallel_analytics(site_id: str, use_sql_warehouse: bool = False, max_workers: int = 5) -> Dict[str, Any]:
    """
    Run SQL queries in parallel using ThreadPoolExecutor.
    - use_sql_warehouse: If True, uses Databricks SQL Warehouse API for execution.
    - Returns state with analytic data and system message.
    """
    queries = get_queries(site_id)
    state = {}
    analytic_data = {}
    
    # MLOps: Log run start
    with mlflow.start_run():
        mlflow.log_param("site_id", site_id)
        mlflow.log_param("num_queries", len(queries))
        mlflow.log_param("use_sql_warehouse", use_sql_warehouse)
    
    def job(query_name: str, query: str):
        if use_sql_warehouse:
            # Fetch config from env (set in Databricks secrets or env vars)
            warehouse_hostname = os.getenv('DATABRICKS_WAREHOUSE_HOSTNAME')
            http_path = os.getenv('DATABRICKS_HTTP_PATH')
            token = os.getenv('DATABRICKS_TOKEN')
            if not all([warehouse_hostname, http_path, token]):
                raise ValueError("SQL Warehouse env vars missing")
            result = execute_sql_warehouse_query(query, warehouse_hostname, http_path, token)
        else:
            result = execute_spark_query(query)
        
        if 'error' not in result:
            processed = process_analytic_data(result['data'], query_name)
            analytic_data.update(processed)
        return result
    
    # Parallel execution with ThreadPoolExecutor
    with ThreadPoolExecutor(max_workers=max_workers) as pool:
        futures = {pool.submit(job, name, q): name for name, q in queries.items()}
        for future in as_completed(futures):
            name = futures[future]
            try:
                result = future.result()
                if 'error' in result:
                    logging.error(f"Query '{name}' failed: {result['error']}")
                    state[f"{name}_error"] = result['error']
            except Exception as e:
                logging.error(f"Future for '{name}' failed: {str(e)}")
                state[f"{name}_error"] = str(e)
    
    # Store analytic data in state
    state["analytic_data"] = analytic_data
    
    # Add system message to state
    state["system_message"] = "Analytics complete"
    
    # MLOps: Log completion and print summary
    mlflow.log_metric("queries_completed", len(analytic_data))
    print(analytic_data)  # Or log to MLflow artifacts
    print("Analytics complete")  # System message
    
    return state

# Example usage
site_id = "example_site_id"  # Input from chat endpoint
state = run_parallel_analytics(site_id, use_sql_warehouse=False)  # Set True for warehouse
print(state)
