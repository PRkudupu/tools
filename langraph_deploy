    _quick_local_test()

    # Deploy: set create_endpoint=True if you want the script to also create/upgrade a Serving endpoint.
    deploy(
        model_name="main.site_ai.site_agent",   # <catalog>.<schema>.<name>
        create_endpoint=False,                  # flip to True to auto-create Serving
        endpoint_name="site-agent"
    )
