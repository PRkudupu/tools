# 1) ------------ Your AGENT GRAPH (edit the 3 node functions as needed) ------------
from langgraph.graph import StateGraph, START, END
import mlflow
import mlflow.pyfunc

# ---- State carried between nodes ----
class SiteState(TypedDict, total=False):
    site_id: Optional[str]
    question: Optional[str]
    filters: Dict[str, Any]
    analytic_data: Dict[str, Any]
    live_data: Dict[str, Any]
    answer: Optional[str]

# ---- Node: fetch analytics (Delta/UC, SQL, etc.) ----
def get_analytic_data(state: SiteState) -> SiteState:
    site_id = state.get("site_id")
    # TODO: replace with real reads (e.g., spark.sql / Delta / UC Volumes)
    state["analytic_data"] = {
        "site_id": site_id,
        "sales_trend_7d": [120, 138, 141, 150, 146, 161, 172],
        "note": "stubbed analytics"
    }
    return state

# ---- Node: fetch live data (external API / telemetry) ----
def getliveData(state: SiteState) -> SiteState:
    # Example: read secrets via Databricks secrets or env
    # api_key = dbutils.secrets.get("scope", "key")  # if you use secrets
    # resp = httpx.get("https://api.example.com/live", params={...})
    # state["live_data"] = resp.json()
    state["live_data"] = {"traffic_now": "moderate", "incidents": 1, "note": "stubbed live"}
    return state

# ---- Node: LLM call (compose context from analytics + live) ----
def call_llm(state: SiteState) -> SiteState:
    q = state.get("question") or "Summarize"
    analytics = state.get("analytic_data", {})
    live = state.get("live_data", {})
    # TODO: replace with your LLM provider call (OpenAI/Azure/Databricks Mosaic)
    # For now, return a deterministic stub so deployment works end-to-end.
    state["answer"] = (
        f"Q: {q}\n"
        f"- Sales 7d trend points: {len(analytics.get('sales_trend_7d', []))}.\n"
        f"- Live traffic: {live.get('traffic_now')} (incidents={live.get('incidents')})."
    )
    return state

# ---- Build and compile the graph ----
def build_graph():
    workflow = StateGraph(SiteState)
    workflow.add_node("get_analytic_data", get_analytic_data)
    workflow.add_node("getliveData", getliveData)
    workflow.add_node("call_llm", call_llm)

    # Fan-out from START so analytics and live can run independently
    workflow.add_edge(START, "get_analytic_data")
    workflow.add_edge(START, "getliveData")

    # Join at call_llm (runs after both upstream nodes finish)
    workflow.add_edge("get_analytic_data", "call_llm")
    workflow.add_edge("getliveData", "call_llm")
    workflow.add_edge("call_llm", END)

    return workflow.compile()

# 2) ------------ MLflow pyfunc wrapper ------------
class GraphModel(mlflow.pyfunc.PythonModel):
    def load_context(self, context):
        # Compile graph once at model load
        self.graph = build_graph()

    def predict(self, context, model_input):
        """
        Accepts:
          - dict for single request
          - list[dict] for batch
          - OR MLflow 'dataframe_records' payload automatically converted to list[dict]
        Returns matching structure (single dict or list[dict]).
        """
        # If MLflow Serving sends a pandas DataFrame, convert rows to dicts
        try:
            import pandas as _pd  # type: ignore
            if isinstance(model_input, _pd.DataFrame):
                model_input = model_input.to_dict(orient="records")
        except Exception:
            pass

        if isinstance(model_input, list):
            return [self.graph.invoke(req) for req in model_input]
        elif isinstance(model_input, dict):
            return self.graph.invoke(model_input)
        else:
            raise TypeError(f"Unsupported input type: {type(model_input)}")

# 3) ------------ Deploy: log, register, (optionally) create serving endpoint ------------
def deploy(
    model_name: str = "main.site_ai.site_agent",   # catalog.schema.name
    create_endpoint: bool = False,                 # set True to auto-create endpoint
    endpoint_name: str = "site-agent",             # serving endpoint name
):
    # Pin lightweight deps; add your real ones (openai/httpx/pydantic/etc.)
    pip_reqs = [
        "mlflow>=2.12.0",
        "langgraph>=0.2.0",
        # "openai>=1.40.0",        # example, if you use OpenAI
        # "httpx>=0.27.0",
        # "pydantic>=2.7",
    ]

    with mlflow.start_run() as run:
        mlflow.pyfunc.log_model(
            artifact_path="model",
            python_model=GraphModel(),
            pip_requirements=pip_reqs,
        )
        model_uri = f"runs:/{run.info.run_id}/model"
        print("Logged model:", model_uri)

    # Register to Unity Catalog
    registered = mlflow.register_model(model_uri=model_uri, name=model_name)
    print("Registered:", model_name, "version:", registered.version)

    # (Optional) Wait until the model is READY before serving
    client = mlflow.tracking.MlflowClient()
    mv = client.get_model_version(name=model_name, version=registered.version)
    while mv.status != "READY":
        time.sleep(2)
        mv = client.get_model_version(name=model_name, version=registered.version)
    print("Model version is READY.")

    # Optionally auto-create a serving endpoint (Serverless Real-Time)
    if create_endpoint:
        # Requires env vars: DATABRICKS_HOST (https://xxx.cloud.databricks.com) and DATABRICKS_TOKEN
        host = os.environ.get("DATABRICKS_HOST")
        token = os.environ.get("DATABRICKS_TOKEN")
        if not host or not token:
            print("Skipping endpoint creation: set DATABRICKS_HOST and DATABRICKS_TOKEN.")
            return

        import requests
        url = f"{host}/api/2.0/serving-endpoints"
        headers = {"Authorization": f"Bearer {token}"}
        payload = {
            "name": endpoint_name,
            "config": {
                "served_entities": [
                    {
                        "entity_name": model_name,
                        "entity_version": registered.version,
                        "min_provisioned_throughput": {
                            "requests_per_second": 1, "scale_to_zero_enabled": True
                        },
                    }
                ]
            }
        }

        # Create or update
        r = requests.post(url, headers=headers, json=payload)
        if r.status_code == 409:
            # already exists -> update
            r = requests.put(f"{url}/{endpoint_name}/config", headers=headers, json=payload["config"])
        r.raise_for_status()
        print(f"Serving endpoint '{endpoint_name}' configured.")

    print("\nDone. To invoke via REST (replace names as needed):")
    print("curl -s -X POST \"$DATABRICKS_HOST/serving-endpoints/site-agent/invocations\" \\")
    print("  -H \"Authorization: Bearer $DATABRICKS_TOKEN\" -H \"Content-Type: application/json\" \\")
    print("  -d '{\"inputs\":[{\"dataframe_records\":[{\"site_id\":\"123\",\"question\":\"status?\",\"filters\":{}}]}]}'")

