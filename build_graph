from typing import TypedDict, Annotated, Dict, List
from langgraph.graph import StateGraph, START, END
from langgraph.graph.message import add_messages
# If you already use ChatDatabricks:
from langchain_databricks import ChatDatabricks

# ---- State as pure primitives (no Pydantic/BaseMessage) ----
class State(TypedDict):
    messages: Annotated[List[Dict], add_messages]  # list of {"role","content"}

# ---- Node that ALWAYS returns a dict update ----
def call_llm(state: State) -> State:
    chat = ChatDatabricks(
        endpoint="databricks-gpt-oss-20b",
        temperature=0.0,
        max_tokens=256,
    )
    # last user input (fallback)
    user_text = ""
    for m in reversed(state.get("messages", [])):
        if m.get("role") == "user":
            user_text = m.get("content", "")
            break

    prompt = f"Tell me a joke about: {user_text or 'anything'}"
    ai = chat.invoke(prompt)      # ai.content is a plain string

    # RETURN A DICT UPDATE (this is key)
    return {"messages": [{"role": "assistant", "content": ai.content}]}

# ---- Build & compile the graph ----
g = StateGraph(State)
g.add_node("call_llm", call_llm)
g.add_edge(START, "call_llm")
g.add_edge("call_llm", END)
graph = g.compile()


import mlflow
from mlflow.pyfunc import PythonModel

class ChatGraphModel(PythonModel):
    # batched predict: list[dict] -> list[dict]
    def predict(self, context, model_input: list[dict]):
        out = []
        for item in model_input:
            # item must be like {"messages":[{"role":"user","content":"..."}]}
            result = graph.invoke(item)   # LangGraph returns a dict state
            out.append(result)            # list[dict] is JSON-serializable
        return out


mlflow.set_experiment("/Users/<your_username>/langgraph_experiments")
mlflow.set_registry_uri("databricks-uc")  # register to UC

registered_name = "main.default.langgraph_llm_model"  # catalog.schema.model

input_example = [
    {"messages": [{"role": "user", "content": "Tell me a joke"}]}
]

with mlflow.start_run():
    mlflow.pyfunc.log_model(
        artifact_path="langgraph_model",
        python_model=ChatGraphModel(),
        input_example=input_example,        # list[dict] avoids signature inference issues
        registered_model_name=registered_name,
    )

print("✅ Registered:", registered_name)
