from typing import TypedDict, Annotated, List, Dict, Any
from databricks_langchain import ChatDatabricks
import mlflow

# Define input state
class State(TypedDict):
    messages: List[Dict[str, str]]  # [{"role": "user", "content": "..."}]

# Define stateless callable wrapper class
class ChatResponder:
    def __init__(self):
        self.chat_model = ChatDatabricks(
            endpoint="databricks-gpt-oss-20b",
            temperature=0.1,
            max_tokens=256
        )

    def __call__(self, state: State) -> State:
        user_text = ""
        for m in reversed(state.get("messages", [])):
            if m.get("role") == "user":
                user_text = m.get("content", "")
                break
        ai = self.chat_model.invoke(user_text or "Say something")
        return {"messages": [{"role": "assistant", "content": str(ai.content)}]}

# Optional: test locally
if __name__ == "__main__":
    responder = ChatResponder()
    input_state = {"messages": [{"role": "user", "content": "Tell me a joke"}]}
    result = responder(input_state)
    print("Assistant:", result["messages"][-1]["content"])

# ✅ Log cleanly with MLflow
responder = ChatResponder()

with mlflow.start_run():
    mlflow.langchain.log_model(
        lc_model=responder,
        name="chat_model_responder",  # Recommended: use `name` instead of deprecated `artifact_path`
        pip_requirements=[
            "mlflow>=2.9",
            "langchain",
            "databricks-langchain"
        ]
    )
    print("✅ Model logged to MLflow successfully.")
