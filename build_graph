# ==== Notebook-friendly LangGraph -> MLflow pyfunc -> UC registration ====
from __future__ import annotations
import json
from typing import Any, Dict, List

import pandas as pd
import mlflow
import mlflow.pyfunc
from mlflow.models import infer_signature

# LangGraph / LangChain-Databricks
from typing_extensions import TypedDict, Annotated
from langgraph.graph import StateGraph, START, END
from langgraph.graph.message import add_messages
from langchain_databricks import ChatDatabricks

# ------------------------
# 1) CONFIG (edit if needed)
# ------------------------
EXPERIMENT = "/Workspace/Users/prathap.kudupu@ecolab.com/cust_brief/src"
CATALOG    = "industrial-data-science"
SCHEMA     = "cbt"
NAME       = "langgraph_model"  # registered object name under CATALOG.SCHEMA

ENDPOINT   = "databricks-gpt-oss-20b"  # change to your serving endpoint (e.g., "databricks-dbrx-instruct")
TEMPERATURE = 0.0
MAX_TOKENS  = 256

# ------------------------
# 2) ACTUAL LangGraph
# ------------------------
class State(TypedDict):
    messages: Annotated[list, add_messages]

def build_graph() -> Any:
    chat_model = ChatDatabricks(
        endpoint=ENDPOINT,
        temperature=TEMPERATURE,
        max_tokens=MAX_TOKENS,
    )

    def generate_reply(state: State) -> State:
        messages = state["messages"]
        if not messages or messages[0].get("role") != "system":
            messages = [{"role": "system", "content": "Tell me a joke"}] + messages
        assistant_message = chat_model.invoke([(m["role"], m["content"]) for m in messages])
        return {"messages": [assistant_message]}

    graph_builder = StateGraph(State)
    graph_builder.add_node("chat_node", generate_reply)
    graph_builder.add_edge(START, "chat_node")
    graph_builder.add_edge("chat_node", END)
    return graph_builder.compile()

# ------------------------
# 3) MLflow PyFunc wrapper
# ------------------------
class ChatGraphModel(mlflow.pyfunc.PythonModel):
    """
    Pyfunc for a LangGraph exposing .invoke(payload).
    Input: DataFrame with 'messages' column (list[dict] or JSON str).
    Output: DataFrame with 'answer' column (JSON string of final state).
    """
    def __init__(self, graph):
        self.graph = graph

    def _row_to_payload(self, row: pd.Series) -> Dict[str, Any]:
        val = row.get("messages", None)
        if isinstance(val, str):
            try:
                val = json.loads(val)
            except Exception:
                val = [{"role": "user", "content": val}]
        if not isinstance(val, list):
            val = [{"role": "user", "content": str(val)}]
        return {"messages": val}

    def predict(self, context, model_input: pd.DataFrame) -> pd.DataFrame:
        outs: List[str] = []
        for _, row in model_input.iterrows():
            payload = self._row_to_payload(row)
            result = self.graph.invoke(payload)  # final state dict (includes "messages")
            outs.append(json.dumps(result))
        return pd.DataFrame({"answer": outs})

# ------------------------
# 4) Log + Register (notebook-safe)
# ------------------------
def log_and_register_pyfunc(
    experiment: str,
    catalog: str,
    schema: str,
    name: str,
) -> str:
    """
    Logs the LangGraph pyfunc and registers it to UC as <catalog>.<schema>.<name>.
    Returns the versioned models URI.
    """
    mlflow.set_registry_uri("databricks-uc")
    mlflow.set_experiment(experiment)

    graph = build_graph()
    py_model = ChatGraphModel(graph)

    # Example input/output for signature (avoid warnings)
    ex_in = pd.DataFrame([{
        "messages": [
            {"role": "system", "content": "You are a helpful assistant."},
            {"role": "user", "content": "Hello!"},
        ]
    }])
    ex_out = py_model.predict(context=None, model_input=ex_in)
    sig = infer_signature(ex_in, ex_out)

    registered_name = f"{catalog}.{schema}.{name}"

    with mlflow.start_run():
        mlflow.pyfunc.log_model(
            artifact_path="langgraph_model",
            python_model=py_model,
            input_example=ex_in,
            signature=sig,
            registered_model_name=registered_name,
            pip_requirements=[
                "mlflow>=2.9.0",
                "pandas>=2.0.0",
                "numpy>=1.24.0",
                "langgraph>=0.2.0",
                "langchain-databricks>=0.1.0",
                "typing-extensions>=4.8.0",
            ],
        )
        # For convenience, return the versioned URI
        run_id = mlflow.active_run().info.run_id
    print(f"Registered MLflow model: {registered_name}")
    return f"models:/{registered_name}"

# ------------------------
# 5) Execute (works in notebook; no CLI args needed)
# ------------------------
uri = log_and_register_pyfunc(
    experiment=EXPERIMENT,
    catalog=CATALOG,
    schema=SCHEMA,
    name=NAME,
)
print("Model URI:", uri)
