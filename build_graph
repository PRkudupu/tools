# langgraph_pyfunc_register.py
"""
Wrap a LangGraph graph as an MLflow pyfunc model and register to Unity Catalog.

Usage:
  python langgraph_pyfunc_register.py \
    --experiment "/Workspace/Users/<you>@<org>.com/cust_brief/src" \
    --catalog industrial-data-science \
    --schema cbt \
    --name langgraph_model
"""

from __future__ import annotations
import argparse
import json
import pandas as pd
import mlflow
import mlflow.pyfunc
from mlflow.models import infer_signature
from typing import Any, Dict, List


# ===== 1) Your graph factory or import =====
# Provide a function that returns a compiled LangGraph object with `.invoke(input)`
# Replace this with your actual graph build.
def build_graph():
    # --- example stub ---
    class EchoGraph:
        def invoke(self, payload: Dict[str, Any]) -> Dict[str, Any]:
            # Expect payload {"messages": [{"role":"user","content":"..."}]}
            msgs = payload.get("messages", [])
            user_text = msgs[-1]["content"] if msgs else ""
            return {"answer": f"Echo: {user_text}"}
    return EchoGraph()


# ===== 2) MLflow PyFunc Wrapper =====
class ChatGraphModel(mlflow.pyfunc.PythonModel):
    """
    Generic pyfunc wrapper for a LangGraph (or similar) graph that exposes `.invoke(payload)`.
    Accepts a pandas.DataFrame with a column 'messages' (list or JSON string).
    Returns a DataFrame with a single column 'answer' (stringified JSON if dict).
    """

    def __init__(self, graph):
        self.graph = graph

    def _row_to_payload(self, row: pd.Series) -> Dict[str, Any]:
        val = row.get("messages", None)
        if isinstance(val, str):
            # If user sent JSON-serialized messages
            try:
                val = json.loads(val)
            except Exception:
                # Treat the string as plain user content
                val = [{"role": "user", "content": val}]
        if not isinstance(val, list):
            # Fallback to a minimal user message
            val = [{"role": "user", "content": str(val)}]
        return {"messages": val}

    def predict(self, context, model_input: pd.DataFrame) -> pd.DataFrame:
        outputs: List[str] = []
        for _, row in model_input.iterrows():
            payload = self._row_to_payload(row)
            result = self.graph.invoke(payload)
            # normalize result -> string for portability
            outputs.append(json.dumps(result))
        return pd.DataFrame({"answer": outputs})


# ===== 3) Log + Register helper =====
def log_and_register_pyfunc(
    experiment: str,
    catalog: str,
    schema: str,
    name: str,
) -> str:
    """
    Logs a LangGraph pyfunc and registers to UC as <catalog>.<schema>.<name>.
    Returns the registered model URI.
    """
    mlflow.set_experiment(experiment)
    mlflow.set_registry_uri("databricks-uc")

    graph = build_graph()
    py_model = ChatGraphModel(graph)

    # Input example as a DataFrame (pyfunc expects DataFrame)
    ex_in = pd.DataFrame(
        [{
            "messages": [
                {"role": "system", "content": "You are a helpful assistant."},
                {"role": "user", "content": "Hello!"},
            ]
        }]
    )
    # Generate output for signature
    tmp_out = py_model.predict(context=None, model_input=ex_in)
    sig = infer_signature(ex_in, tmp_out)

    registered_name = f"{catalog}.{schema}.{name}"

    with mlflow.start_run():
        mlflow.pyfunc.log_model(
            artifact_path="langgraph_model",
            python_model=py_model,
            input_example=ex_in,
            signature=sig,
            registered_model_name=registered_name,
            # Keep deps minimal; add others you actually need.
            pip_requirements=[
                "mlflow>=2.9.0",
                "pandas>=2.0.0",
                "numpy>=1.24.0",
                "langgraph>=0.2.0",      # your version
                "langchain>=0.2.0",      # if your graph needs it
                "pydantic>=2.0.0",
            ],
        )

    print(f"Registered MLflow model: {registered_name}")
    return f"models:/{registered_name}"


# ===== 4) CLI =====
def parse_args():
    ap = argparse.ArgumentParser(description="Log & register a LangGraph as MLflow pyfunc.")
    ap.add_argument("--experiment", required=True, help="MLflow experiment path")
    ap.add_argument("--catalog", required=True, help="Unity Catalog name (e.g., industrial-data-science)")
    ap.add_argument("--schema", required=True, help="Schema/database (e.g., cbt)")
    ap.add_argument("--name", default="langgraph_model", help="Model object name")
    return ap.parse_args()


if __name__ == "__main__":
    args = parse_args()
    log_and_register_pyfunc(
        experiment=args.experiment,
        catalog=args.catalog,
        schema=args.schema,
        name=args.name,
    )
