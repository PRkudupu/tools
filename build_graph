from __future__ import annotations
import json
from typing import Any, Dict, List, Tuple

import pandas as pd
import mlflow
import mlflow.pyfunc
from mlflow.models import infer_signature

# LangGraph (no MessagesState import)
from typing_extensions import TypedDict, Annotated
from langgraph.graph import StateGraph, START, END
from langgraph.graph.message import add_messages

# Databricks LLM client
from databricks_langchain import ChatDatabricks


# ---------- 1) State & helpers ----------
class State(TypedDict):
    # A list of chat messages. We annotate with add_messages so LangGraph appends properly.
    messages: Annotated[list, add_messages]
    # Final text result (assistant reply)
    result: str

def _normalize_messages(raw) -> List[Tuple[str, str]]:
    """
    Accepts:
      - list[(role, content)]
      - list[{role, content}]
      - list[LC message objects with .type/.role & .content]
      - str (treated as user message)
    Returns list[(role, content)] in lower-case roles.
    """
    if isinstance(raw, str):
        return [("user", raw)]
    out: List[Tuple[str, str]] = []
    for m in raw or []:
        if isinstance(m, tuple) and len(m) >= 2:
            out.append((str(m[0]).lower(), str(m[1])))
            continue
        if isinstance(m, dict) and "content" in m:
            role = str(m.get("role", m.get("type", "user"))).lower()
            out.append((role, str(m["content"])))
            continue
        # LangChain message-like
        role = getattr(m, "type", getattr(m, "role", "user"))
        content = getattr(m, "content", None)
        if content is not None:
            out.append((str(role).lower(), str(content)))
        else:
            out.append(("user", str(m)))
    return out


# ---------- 2) Build the LangGraph ----------
def build_graph(endpoint: str) -> Any:
    chat = ChatDatabricks(endpoint=endpoint, temperature=0.0, max_tokens=256)

    def ensure_system(state: State) -> State:
        pairs = _normalize_messages(state["messages"])
        if not pairs or pairs[0][0] != "system":
            pairs.insert(0, ("system", "You are a helpful assistant."))
        # Replace state.messages with normalized pairs
        return {"messages": pairs}  # add_messages will handle appending in next node

    def llm_call(state: State) -> State:
        pairs = state["messages"]  # already normalized
        ai_msg = chat.invoke(pairs)             # returns LC message object
        text = getattr(ai_msg, "content", str(ai_msg))
        # Append assistant message and set result
        return {"messages": [("assistant", text)], "result": text}

    gb = StateGraph(State)
    gb.add_node("ensure_system", ensure_system)
    gb.add_node("llm_call", llm_call)
    gb.add_edge(START, "ensure_system")
    gb.add_edge("ensure_system", "llm_call")
    gb.add_edge("llm_call", END)
    return gb.compile()


GRAPH = build_graph(ENDPOINT)


# ---------- 3) MLflow pyfunc wrapper ----------
class LangGraphPyfunc(mlflow.pyfunc.PythonModel):
    def __init__(self, endpoint_name: str):
        self.endpoint_name = endpoint_name

    def load_context(self, context):
        # Rebuild graph at load/serve time
        self.graph = build_graph(self.endpoint_name)

    def predict(self, context, model_input: pd.DataFrame) -> pd.DataFrame:
        """
        Expect a DataFrame with a column 'messages' (list/tuple/dict/str as described).
        Returns a DataFrame with column 'result' (assistant reply text).
        """
        results: List[str] = []
        for msgs in model_input["messages"]:
            out_state = self.graph.invoke({"messages": msgs})
            results.append(out_state["result"])
        return pd.DataFrame({"result": results})


