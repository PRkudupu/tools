# ------------------------
# State: extend MessagesState with a 'result' field
# ------------------------
class State(MessagesState):
    result: str

# ------------------------
# Helpers: normalize messages to list[(role, content)]
# ------------------------
def _as_role_content_list(msgs) -> List[tuple]:
    """
    Accepts messages as tuples, dicts, or LangChain message objects and returns
    a normalized list of (role, content) tuples for ChatDatabricks.invoke.
    """
    out: List[tuple] = []
    for m in msgs:
        # Already a tuple
        if isinstance(m, tuple) and len(m) >= 2:
            out.append((str(m[0]), str(m[1])))
            continue
        # Dict format
        if isinstance(m, dict) and "content" in m:
            role = str(m.get("role", m.get("type", "user"))).lower()
            out.append((role, str(m["content"])))
            continue
        # LangChain message object (no import needed)
        content = getattr(m, "content", None)
        role    = getattr(m, "type", getattr(m, "role", "user"))
        if content is not None:
            out.append((str(role), str(content)))
            continue
        # Fallback: treat as user text
        out.append(("user", str(m)))
    return out

# ------------------------
# Build LangGraph using ChatDatabricks
# ------------------------
chat_model = ChatDatabricks(endpoint=ENDPOINT, temperature=0.0, max_tokens=256)

def ensure_system_node(state: Dict[str, Any]) -> Dict[str, Any]:
    msgs = state["messages"]
    pairs = _as_role_content_list(msgs)
    # inject system if missing
    if not pairs or pairs[0][0] != "system":
        pairs.insert(0, ("system", "You are a helpful assistant."))
    return {"messages": pairs}

def llm_node(state: Dict[str, Any]) -> Dict[str, Any]:
    pairs = state["messages"]  # already normalized by ensure_system_node
    ai_msg = chat_model.invoke(pairs)  # returns an LC message-like object
    # robustly extract text without importing LC classes
    text = getattr(ai_msg, "content", str(ai_msg))
    # Append assistant message as a tuple so state stays uniform
    return {"messages": [("assistant", text)], "result": text}

builder = StateGraph(State, input_schema=MessagesState, output_schema={"result": str})
builder.add_node("ensure_system", ensure_system_node)
builder.add_node("llm", llm_node)
builder.add_edge(START, "ensure_system")
builder.add_edge("ensure_system", "llm")
builder.add_edge("llm", END)
graph = builder.compile()

# ------------------------
# MLflow pyfunc wrapper
# ------------------------
class LangGraphPyfunc(mlflow.pyfunc.PythonModel):
    def __init__(self, endpoint_name: str):
        self.endpoint_name = endpoint_name

    def load_context(self, context):
        self._chat = ChatDatabricks(endpoint=self.endpoint_name, temperature=0.0, max_tokens=256)

        def _ensure(state):
            pairs = _as_role_content_list(state["messages"])
            if not pairs or pairs[0][0] != "system":
                pairs.insert(0, ("system", "You are a helpful assistant."))
            return {"messages": pairs}

        def _llm(state):
            pairs = state["messages"]
            ai_msg = self._chat.invoke(pairs)
            text = getattr(ai_msg, "content", str(ai_msg))
            return {"messages": [("assistant", text)], "result": text}

        b = StateGraph(State, input_schema=MessagesState, output_schema={"result": str})
        b.add_node("ensure_system", _ensure)
        b.add_node("llm", _llm)
        b.add_edge(START, "ensure_system")
        b.add_edge("ensure_system", "llm")
        b.add_edge("llm", END)
        self._graph = b.compile()

    def predict(self, context, model_input: pd.DataFrame) -> pd.DataFrame:
        results: List[str] = []
        for msgs in model_input["messages"]:
            out = self._graph.invoke({"messages": msgs})
            results.append(out["result"])
        return pd.DataFrame({"result": results})

