from typing import TypedDict, Annotated, List, Any
from langgraph.graph import StateGraph, START, END
from langchain.chat_models import ChatDatabricks
from langchain.schema import HumanMessage, AIMessage, SystemMessage
import mlflow
import pandas as pd
from dataclasses import dataclass

# Define the state
class State(TypedDict):
    messages: Annotated[List[dict], "add_messages"]

# Create chat model using Databricks endpoint
def build_graph() -> Any:
    chat_model = ChatDatabricks(
        endpoint="databricks-llama-2-70b-chat",  # Use your available endpoint
        temperature=0.7,
        max_tokens=256
    )
    
    # Chat reply function
    def generate_reply(state: State):
        # Extract the conversation messages list from state
        messages = state["messages"]
        
        # Ensure a system prompt is included
        if not messages or messages[0].get("role") != "system":
            messages = [{"role": "system", "content": "You are a helpful assistant. Provide concise and helpful responses."}] + messages
        
        # Convert to LangChain message format
        lc_messages = []
        for msg in messages:
            if msg["role"] == "system":
                lc_messages.append(SystemMessage(content=msg["content"]))
            elif msg["role"] == "user":
                lc_messages.append(HumanMessage(content=msg["content"]))
            elif msg["role"] == "assistant":
                lc_messages.append(AIMessage(content=msg["content"]))
        
        # Get response from Databricks endpoint
        assistant_message = chat_model.invoke(lc_messages)
        
        # Return the assistant message
        return {"messages": [{"role": "assistant", "content": assistant_message.content}]}
    
    # Build LangGraph
    graph_builder = StateGraph(State)
    graph_builder.add_node("chat_node", generate_reply)
    graph_builder.add_edge(START, "chat_node")
    graph_builder.add_edge("chat_node", END)
    
    # Compile the graph
    graph = graph_builder.compile()
    return graph

# Initialize the graph
chat_graph = build_graph()

import mlflow.pyfunc

class DatabricksChatModel(mlflow.pyfunc.PythonModel):
    def __init__(self):
        self.graph = build_graph()
    
    def predict(self, context, model_input):
        """
        Expected input: pandas DataFrame with 'message' column
        Returns: pandas Series with responses
        """
        if isinstance(model_input, dict):
            user_message = model_input.get('message', '')
        else:
            user_message = model_input.iloc[0]['message'] if len(model_input) > 0 else ''
        
        # Run through LangGraph
        result = self.graph.invoke({
            "messages": [
                {"role": "user", "content": user_message}
            ]
        })
        
        # Extract the last assistant message
        assistant_messages = [msg for msg in result["messages"] if msg["role"] == "assistant"]
        response = assistant_messages[-1]["content"] if assistant_messages else "No response generated"
        
        return [response]

# Define model signature
from mlflow.models.signature import ModelSignature
from mlflow.types.schema import Schema, ColSpec

input_schema = Schema([
    ColSpec("string", "message")
])

output_schema = Schema([
    ColSpec("string")
])

signature = ModelSignature(inputs=input_schema, outputs=output_schema)

# Test the chat model
def test_chat():
    test_graph = build_graph()
    
    # Test conversation
    result = test_graph.invoke({
        "messages": [
            {"role": "user", "content": "Hello! How are you today?"}
        ]
    })
    
    print("User: Hello! How are you today?")
    for msg in result["messages"]:
        if msg["role"] == "assistant":
            print(f"Assistant: {msg['content']}")
    
    return result

