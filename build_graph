# ---------------------------
# Imports and Setup
# ---------------------------
import mlflow
import pandas as pd

# LangChain & LangGraph imports
from databricks_langchain import ChatDatabricks
from langchain.schema import BaseMessage, AIMessage, HumanMessage, SystemMessage
from langgraph.graph import StateGraph, START, END
from langgraph.graph.message import MessagesState

from typing import Any, List, Dict
from typing_extensions import TypedDict

# --------------------------------------------
# Define LangGraph state schema using MessagesState
# --------------------------------------------
class State(MessagesState):
    """Combined state holding conversation messages and LLM result."""
    result: str  # will store the assistant response text

class OutputState(TypedDict):
    """Output schema for the graph (only the final result)."""
    result: str

# --------------------------------------------
# Build the LangGraph with message handling
# --------------------------------------------
# Create the LLM instance (ChatDatabricks) for the graph. 
# This wraps a Databricks serving endpoint (must support OpenAI chat format).
chat_model = ChatDatabricks(endpoint=endpoint_name)  # e.g., wraps a 20B OSS model endpoint

# Define graph node: ensure a system prompt is present
def ensure_system_node(state: Dict[str, Any]) -> Dict[str, Any]:
    """If no system message in the conversation, prepend a default system prompt."""
    msgs = state["messages"]
    converted_msgs: List[BaseMessage] = []
    for m in msgs:
        # Convert tuples or dicts into LangChain message objects for uniformity
        if isinstance(m, BaseMessage):
            converted_msgs.append(m)
        elif isinstance(m, tuple) and len(m) >= 2:
            role, content = m[0], m[1]
            if role in ("system", "assistant", "user", "human", "ai"):
                if role == "system":
                    converted_msgs.append(SystemMessage(content=content))
                elif role == "user" or role == "human":
                    converted_msgs.append(HumanMessage(content=content))
                elif role == "assistant" or role == "ai":
                    converted_msgs.append(AIMessage(content=content))
            else:
                converted_msgs.append(HumanMessage(content=content))
        elif isinstance(m, dict) and "content" in m:
            # Accept dict format with 'role' or 'type'
            role = m.get("role", m.get("type", "")).lower()
            content = m["content"]
            if role == "system":
                converted_msgs.append(SystemMessage(content=content))
            elif role == "user" or role == "human":
                converted_msgs.append(HumanMessage(content=content))
            elif role == "assistant" or role == "ai":
                converted_msgs.append(AIMessage(content=content))
            else:
                converted_msgs.append(HumanMessage(content=content))
        else:
            # Fallback: treat any unknown format as a human message
            converted_msgs.append(HumanMessage(content=str(m)))
    # Inject default system message if none exists
    if not any(isinstance(msg, SystemMessage) for msg in converted_msgs):
        converted_msgs.insert(0, SystemMessage(content="You are a helpful assistant."))
    return {"messages": converted_msgs}

# Define graph node: call the ChatDatabricks LLM and append its response
def llm_response_node(state: Dict[str, Any]) -> Dict[str, Any]:
    """Call the LLM on the accumulated messages and return the assistant's reply."""
    msgs = state["messages"]
    # Invoke the chat model (returns an AIMessage)
    ai_message: BaseMessage = chat_model.invoke(msgs)
    # Append the AI response message and also set the result text
    return {"messages": [ai_message], "result": ai_message.content}

# Build the graph structure using StateGraph
builder = StateGraph(State, input_schema=MessagesState, output_schema=OutputState)
builder.add_node("ensure_system", ensure_system_node)
builder.add_node("llm_call", llm_response_node)
builder.add_edge(START, "ensure_system")
builder.add_edge("ensure_system", "llm_call")
builder.add_edge("llm_call", END)
graph = builder.compile()

# ---------------------------------------------------
# Define an MLflow pyfunc model class wrapping the graph
# ---------------------------------------------------
class LangGraphModel(mlflow.pyfunc.PythonModel):
    def load_context(self, context):
        """
        Initialize resources when the model is loaded.
        Re-create the ChatDatabricks model and compiled graph for the production environment.
        """
        # Note: If running outside Databricks, ensure DATABRICKS_HOST and DATABRICKS_TOKEN env vars are set.
        self.chat_model = ChatDatabricks(endpoint=self.endpoint_name)
        # Re-build the graph nodes (ensuring we use the ChatDatabricks instance above)
        def _ensure_system(state: Dict[str, Any]) -> Dict[str, Any]:
            # (Same logic as ensure_system_node defined earlier)
            msgs = state["messages"]
            converted_msgs: List[BaseMessage] = []
            for m in msgs:
                if isinstance(m, BaseMessage):
                    converted_msgs.append(m)
                elif isinstance(m, tuple) and len(m) >= 2:
                    role, content = m[0], m[1]
                    if role == "system":
                        converted_msgs.append(SystemMessage(content=content))
                    elif role == "user" or role == "human":
                        converted_msgs.append(HumanMessage(content=content))
                    elif role == "assistant" or role == "ai":
                        converted_msgs.append(AIMessage(content=content))
                    else:
                        converted_msgs.append(HumanMessage(content=content))
                elif isinstance(m, dict) and "content" in m:
                    role = m.get("role", m.get("type", "")).lower()
                    content = m["content"]
                    if role == "system":
                        converted_msgs.append(SystemMessage(content=content))
                    elif role == "user" or role == "human":
                        converted_msgs.append(HumanMessage(content=content))
                    elif role == "assistant" or role == "ai":
                        converted_msgs.append(AIMessage(content=content))
                    else:
                        converted_msgs.append(HumanMessage(content=content))
                else:
                    converted_msgs.append(HumanMessage(content=str(m)))
            if not any(isinstance(msg, SystemMessage) for msg in converted_msgs):
                converted_msgs.insert(0, SystemMessage(content="You are a helpful assistant."))
            return {"messages": converted_msgs}
        def _llm_call(state: Dict[str, Any]) -> Dict[str, Any]:
            msgs = state["messages"]
            ai_msg = self.chat_model.invoke(msgs)
            return {"messages": [ai_msg], "result": ai_msg.content}
        # Build graph for this model instance
        builder = StateGraph(State, input_schema=MessagesState, output_schema=OutputState)
        builder.add_node("ensure_system", _ensure_system)
        builder.add_node("llm_call", _llm_call)
        builder.add_edge(START, "ensure_system")
        builder.add_edge("ensure_system", "llm_call")
        builder.add_edge("llm_call", END)
        self.graph = builder.compile()

    def __init__(self, endpoint_name: str):
        # Store the serving endpoint name (for use in load_context)
        self.endpoint_name = endpoint_name

    def predict(self, context, model_input: pd.DataFrame) -> pd.DataFrame:
        """
        Apply the LangGraph model to each row of input DataFrame.
        Expects a 'messages' column containing a list of messages (tuples, dicts, or BaseMessage objects).
        Returns a DataFrame with a 'result' column (assistant response text).
        """
        results: List[str] = []
        # Iterate over each input (each row represents one conversation/messages list)
        for messages in model_input["messages"]:
            # Invoke the graph with the given messages
            output_state = self.graph.invoke({"messages": messages})
            # Extract the assistant response text from the output state
            results.append(output_state["result"])
        return pd.DataFrame({"result": results})

