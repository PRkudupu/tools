<mxfile host="app.diagrams.net">
  <diagram name="Agent Sequence Architecture">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="user" value="User / Frontend" style="swimlane;vertical=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="150" height="900" as="geometry"/>
        </mxCell>

        <mxCell id="planner" value="Planner Agent (Orchestrator)" style="swimlane;vertical=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="180" height="900" as="geometry"/>
        </mxCell>

        <mxCell id="cache" value="Conversation Cache" style="swimlane;vertical=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="20" width="160" height="900" as="geometry"/>
        </mxCell>

        <mxCell id="llm" value="LLM (Claude)" style="swimlane;vertical=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="20" width="160" height="900" as="geometry"/>
        </mxCell>

        <mxCell id="subagent" value="Sub-Agent Layer" style="swimlane;vertical=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="20" width="160" height="900" as="geometry"/>
        </mxCell>

        <mxCell id="servicenow" value="ServiceNow" style="swimlane;vertical=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="20" width="160" height="900" as="geometry"/>
        </mxCell>

        <mxCell id="gws" value="GWS / CRM" style="swimlane;vertical=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="20" width="160" height="900" as="geometry"/>
        </mxCell>

        <mxCell id="webhook" value="Webhook Receiver" style="swimlane;vertical=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="20" width="160" height="900" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
