# Note: This code assumes you have installed the necessary libraries in your Databricks cluster or notebook,
# such as langchain, langchain-community, langgraph, and pyspark. If using Databricks Model Serving,
# configure your LLM endpoint accordingly. Replace placeholders like the LLM endpoint and table name as needed.

from langgraph.graph import START, StateGraph, MessagesState
from langgraph.prebuilt import ToolNode, tools_condition
from langchain_community.agent_toolkits import SparkSQLToolkit
from langchain_community.utilities.spark_sql import SparkSQL
from langchain_community.chat_models import ChatDatabricks  # Use ChatOpenAI if not using Databricks models
from langchain_core.messages import HumanMessage, SystemMessage
from pyspark.sql import SparkSession

# Get the Spark session (already available in Databricks as 'spark')
spark = SparkSession.builder.getOrCreate()

# Define the schema where your Delta table resides (e.g., 'default' or 'your_catalog.your_schema')
schema = "default"

# Initialize SparkSQL utility for the schema
spark_sql = SparkSQL(schema=schema)

# Initialize the LLM (replace with your Databricks serving endpoint or use OpenAI)
llm = ChatDatabricks(
    endpoint="databricks-meta-llama-3-70b-instruct",  # Example endpoint; replace with yours
    temperature=0.1
)

# Create the Spark SQL toolkit (provides tools like query_sql_database, info_sql_database, etc.)
toolkit = SparkSQLToolkit(db=spark_sql, llm=llm)
tools = toolkit.get_tools()

# Bind tools to the LLM
llm_with_tools = llm.bind_tools(tools)

# System prompt for the agent
system_message = SystemMessage(
    content="You are a helpful assistant that queries Delta tables using SQL tools to retrieve live data. "
            "Use the provided tools to execute SQL queries on the Delta table for accurate, real-time information. "
            "Assume the Delta table is named 'my_delta_table' unless specified otherwise."
)

# Define the assistant node
def assistant(state: MessagesState):
    return {"messages": [llm_with_tools.invoke([system_message] + state["messages"])]}

# Build the LangGraph
builder = StateGraph(MessagesState)

# Add nodes
builder.add_node("assistant", assistant)
builder.add_node("tools", ToolNode(tools))

# Add edges
builder.add_edge(START, "assistant")
builder.add_conditional_edges(
    "assistant",
    tools_condition  # Routes to 'tools' if tool calls are needed, else to END
)
builder.add_edge("tools", "assistant")

# Compile the graph
graph = builder.compile()

