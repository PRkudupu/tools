pool:
  vmImage: 'ubuntu-latest'

steps:
- checkout: self

# -------------------------------------------------------
# Install Databricks CLI (Correct Binary - No ZIP)
# -------------------------------------------------------
- script: |
    echo "Downloading Databricks CLI..."
    curl -L -o databricks "https://github.com/databricks/cli/releases/latest/download/databricks_linux_amd64"
    chmod +x databricks
    echo "##vso[task.prependpath]$PWD"
    databricks version
  displayName: 'Install Databricks CLI'

# -------------------------------------------------------
# Authenticate to Databricks
# -------------------------------------------------------
- script: |
    databricks auth login \
      --host "$(DATABRICKS_HOST)" \
      --token "$(DATABRICKS_TOKEN)"
  displayName: 'Login to Databricks'
  env:
    DATABRICKS_HOST: $(DATABRICKS_HOST)
    DATABRICKS_TOKEN: $(DATABRICKS_TOKEN)

# -------------------------------------------------------
# Validate Bundle
# -------------------------------------------------------
- script: |
    databricks bundle validate --target dev
  displayName: 'Validate Databricks Bundle'

# -------------------------------------------------------
# Deploy Bundle
# -------------------------------------------------------
- script: |
    databricks bundle deploy --target dev
  displayName: 'Deploy Databricks Bundle'
  env:
    DATABRICKS_TOKEN: $(DATABRICKS_TOKEN)
