pool:
  vmImage: 'ubuntu-latest'

steps:
- checkout: self

- script: |
    # Download the latest Databricks CLI binary (Linux AMD64)
    curl -LJO "https://github.com/databricks/cli/releases/latest/download/databricks_cli_linux_amd64.zip"
    
    # Extract and make executable
    unzip databricks_cli_linux_amd64.zip
    chmod +x databricks
    
    # Add to PATH for this step and subsequent ones
    echo "##vso[task.prependpath]$PWD"
    
    # Verify installation
    databricks --version
  displayName: 'Install Databricks CLI Binary'

- script: |
    databricks auth login \
      --host "$(DATABRICKS_HOST)" \
      --token "$(DATABRICKS_TOKEN)"
  displayName: 'Authenticate to Databricks'
  env:
    DATABRICKS_HOST: $(DATABRICKS_HOST)
    DATABRICKS_TOKEN: $(DATABRICKS_TOKEN)

- script: |
    databricks bundle validate --target dev
  displayName: 'Validate Databricks Bundle (dev)'

- script: |
    databricks bundle deploy --target dev
  displayName: 'Deploy Databricks Bundle (dev)'
  env:
    DATABRICKS_TOKEN: $(DATABRICKS_TOKEN)
