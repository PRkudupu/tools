trigger:
  branches:
    include:
      - feature/pipeline_dev

pr:
  branches:
    include:
      - "*"

parameters:
- name: targetEnv
  type: string
  default: dev
  values: [dev, stg, prd, all]

stages:
- stage: validate
  displayName: Validate
  jobs:
  - job: validate
    displayName: DAB Validate (matrix)
    pool:
      name: AdvancedAnalytics
      demands:
        - Agent.Name -equals USEAGTFSVBL23P1

    strategy:
      matrix:
        dev: { BUNDLE_TARGET: dev }
        stg: { BUNDLE_TARGET: stg }
        prd: { BUNDLE_TARGET: prd }

    # Run only selected env, or all
    condition: |
      or(
        eq('${{ parameters.targetEnv }}','all'),
        eq(variables['BUNDLE_TARGET'],'${{ parameters.targetEnv }}')
      )

    # pick correct variable group for each env
    variables:
    - ${{ if eq(variables['BUNDLE_TARGET'], 'dev') }}:
      - group: AIF_DBX_CUSTBRIEF_AGENT_DEV
    - ${{ if eq(variables['BUNDLE_TARGET'], 'stg') }}:
      - group: AIF_DBX_CUSTBRIEF_AGENT_STG
    - ${{ if eq(variables['BUNDLE_TARGET'], 'prd') }}:
      - group: AIF_DBX_CUSTBRIEF_AGENT_PRD

    steps:
    - checkout: self

    - task: PowerShell@2
      displayName: "Preflight + Validate"
      inputs:
        pwsh: true
        targetType: inline
        workingDirectory: "$(Build.SourcesDirectory)"
        script: |
          $ErrorActionPreference='Stop'
          Set-StrictMode -Version Latest

          function Require($name) { if (-not (Get-Item "Env:$name" -ErrorAction SilentlyContinue)) { throw "Missing env var: $name" } }
          function RunDab($cmd) {
            Write-Host "##[command]databricks bundle $cmd -t $(BUNDLE_TARGET)"
            & databricks bundle @($cmd.Split(' ')) -t "$(BUNDLE_TARGET)"
            if ($LASTEXITCODE -ne 0) { throw "Failed: databricks bundle $cmd -t $(BUNDLE_TARGET)" }
          }

          Require DATABRICKS_HOST
          Require DATABRICKS_CLIENT_ID
          Require DATABRICKS_CLIENT_SECRET

          Write-Host "##[group]Info"
          Write-Host "Branch: $(Build.SourceBranch) | Reason: $(Build.Reason) | Target: $(BUNDLE_TARGET)"
          databricks --version
          Write-Host "Repo root: $((Get-Location).Path)"
          Write-Host "##[endgroup]"

          RunDab "validate"
      env:
        DATABRICKS_HOST: $(DATABRICKS_HOST)
        DATABRICKS_CLIENT_ID: $(DATABRICKS_CLIENT_ID)
        DATABRICKS_CLIENT_SECRET: $(DATABRICKS_CLIENT_SECRET)

- stage: deploy
  displayName: Deploy + Run
  dependsOn: validate
  condition: succeeded()
  jobs:
  - job: deploy
    displayName: Deploy/Run (matrix)
    pool:
      name: AdvancedAnalytics
      demands:
        - Agent.Name -equals USEAGTFSVBL23P1

    strategy:
      matrix:
        dev: { BUNDLE_TARGET: dev }
        stg: { BUNDLE_TARGET: stg }
        prd: { BUNDLE_TARGET: prd }

    condition: |
      or(
        eq('${{ parameters.targetEnv }}','all'),
        eq(variables['BUNDLE_TARGET'],'${{ parameters.targetEnv }}')
      )

    variables:
    - ${{ if eq(variables['BUNDLE_TARGET'], 'dev') }}:
      - group: AIF_DBX_CUSTBRIEF_AGENT_DEV
    - ${{ if eq(variables['BUNDLE_TARGET'], 'stg') }}:
      - group: AIF_DBX_CUSTBRIEF_AGENT_STG
    - ${{ if eq(variables['BUNDLE_TARGET'], 'prd') }}:
      - group: AIF_DBX_CUSTBRIEF_AGENT_PRD

    steps:
    - checkout: self

    - task: PowerShell@2
      displayName: "Deploy + Run custbrief_pipeline"
      inputs:
        pwsh: true
        targetType: inline
        workingDirectory: "$(Build.SourcesDirectory)"
        script: |
          $ErrorActionPreference='Stop'
          Set-StrictMode -Version Latest

          function Require($name) { if (-not (Get-Item "Env:$name" -ErrorAction SilentlyContinue)) { throw "Missing env var: $name" } }
          function RunDab($cmd) {
            Write-Host "##[command]databricks bundle $cmd -t $(BUNDLE_TARGET)"
            & databricks bundle @($cmd.Split(' ')) -t "$(BUNDLE_TARGET)"
            if ($LASTEXITCODE -ne 0) { throw "Failed: databricks bundle $cmd -t $(BUNDLE_TARGET)" }
          }

          Require DATABRICKS_HOST
          Require DATABRICKS_CLIENT_ID
          Require DATABRICKS_CLIENT_SECRET

          Write-Host "##[group]Deploy/Run"
          Write-Host "Target: $(BUNDLE_TARGET)"
          Write-Host "##[endgroup]"

          RunDab "deploy"
          RunDab "run custbrief_pipeline"
      env:
        DATABRICKS_HOST: $(DATABRICKS_HOST)
        DATABRICKS_CLIENT_ID: $(DATABRICKS_CLIENT_ID)
        DATABRICKS_CLIENT_SECRET: $(DATABRICKS_CLIENT_SECRET)
