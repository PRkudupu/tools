from concurrent.futures import ThreadPoolExecutor, as_completed
from typing import Dict, List, Any
import sql_connect  # assuming this is your custom module

# --- Helper function ---
def execute_query(name: str, query: str) -> tuple[str, List[Dict[str, Any]]]:
    try:
        with sql_connect.connect(
            server_hostname=sql_connect.SERVER_HOSTNAME,
            http_path=sql_connect.HTTP_PATH,
            access_token=sql_connect.ACCESS_TOKEN
        ) as conn:
            with conn.cursor() as cur:
                # Set session to correct catalog/schema
                cur.execute(f"USE CATALOG `{sql_connect.CATALOG}`")
                cur.execute(f"USE `{sql_connect.SCHEMA}`")
                cur.execute(query)
                rows = cur.fetchall()
                # Convert to list of dicts with column names
                cols = [d[0] for d in cur.description]
                result = [dict(zip(cols, r)) for r in rows]
                return name, result
    except Exception as e:
        return name, {"error": str(e)}

# --- Main parallel execution ---
def run_queries_in_parallel(queries: Dict[str, str]) -> Dict[str, Any]:
    analytic_data: Dict[str, Any] = {}
    max_workers = min(8, len(queries))  # Respect warehouse concurrency limits

    with ThreadPoolExecutor(max_workers=max_workers) as pool:
        # Submit all queries
        futures = [
            pool.submit(execute_query, name, query)
            for name, query in queries.items()
        ]
        # Collect results as they complete
        for future in as_completed(futures):
            name, result = future.result()
            analytic_data[name] = result

    state = {"analytic_data": analytic_data}
    print("Analytic data:", analytic_data)
    return state

