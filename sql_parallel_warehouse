from databricks import sql
from concurrent.futures import ThreadPoolExecutor, as_completed
from typing import List, Dict, Any
import os

# --------------------------------------------------------------
# 1. CONFIGURATION
# --------------------------------------------------------------
# === REQUIRED: Update these values ===
HOST      = "adb-1355704782079007.7.azuredatabricks.net"   # Your workspace URL
WAREHOUSE = "sql/1.0/warehouses/aabc3a9405a7c8961"        # SQL Warehouse HTTP path
CATALOG   = "main"                                        # Unity Catalog catalog
SCHEMA    = "sales"                                       # Schema inside catalog
SITE_ID   = 12345                                         # Your site_id

# === OPTIONAL: Use Databricks Secret Scope (Recommended) ===
# Uncomment and set scope/key if using secrets
# TOKEN = dbutils.secrets.get(scope="uc-scope", key="sql-warehouse-token")
# Otherwise, hardcode (NOT for production):
TOKEN = "dapic6854bd4f0c39e91b51999a2efd8b6f1-3"

# --------------------------------------------------------------
# 2. QUERY RUNNER (Unity Catalog + SQL Warehouse)
# --------------------------------------------------------------
def run_query(name: str, sql_text: str, params: Dict[str, Any] = None) -> List[Dict[str, Any]]:
    """
    Executes a parameterized SQL query against Unity Catalog via SQL Warehouse.
    Returns list of dicts (one per row).
    """
    params = params or {}
    try:
        with sql.connect(
            server_hostname=HOST,
            http_path=WAREHOUSE,
            access_token=TOKEN
        ) as conn:
            with conn.cursor() as cur:
                cur.execute(sql_text, params)
                columns = [column[0] for column in cur.description]
                rows = cur.fetchall()
                return [dict(zip(columns, row)) for row in rows]
    except Exception as e:
        print(f"[ERROR] Query '{name}' failed: {e}")
        return []

# --------------------------------------------------------------
# 3. QUERY CATALOG (Fully qualified UC tables + :param syntax)
# --------------------------------------------------------------
queries = {
    "site_account_mapping":    f"SELECT * FROM {CATALOG}.{SCHEMA}.SITE_ACCOUNT_MAPPING WHERE site_id = :site_id",
    "mpl_spl_penetration":     f"SELECT * FROM {CATALOG}.{SCHEMA}.MPL_SPL_PENETRATION WHERE site_id = :site_id",
    "last_interaction":        f"SELECT * FROM {CATALOG}.{SCHEMA}.LAST_INTERACTION WHERE site_id = :site_id",
    "solution_price_change":   f"SELECT * FROM {CATALOG}.{SCHEMA}.SOLUTION_PRICE_CHANGE WHERE site_id = :site_id",
    "sales_wrt_last_year":     f"SELECT * FROM {CATALOG}.{SCHEMA}.SALES_WRT_LAST_YEAR WHERE site_id = :site_id",
    "pending_services":        f"SELECT * FROM {CATALOG}.{SCHEMA}.PENDING_SERVICES WHERE site_id = :site_id",
    "percentage_solution_sales_change": f"SELECT * FROM {CATALOG}.{SCHEMA}.PERCENTAGE_SOLUTION_SALES_CHANGE WHERE site_id = :site_id",
    "asset_location":          f"SELECT * FROM {CATALOG}.{SCHEMA}.ASSET_LOCATION WHERE site_id = :site_id",
    "sales_info_mtd":          f"SELECT * FROM {CATALOG}.{SCHEMA}.SALES_INFO_MTD WHERE site_id = :site_id",
    "sales_info_ytd_r12":      f"SELECT * FROM {CATALOG}.{SCHEMA}.SALES_INFO_YTD_R12 WHERE site_id = :site_id",
}

# --------------------------------------------------------------
# 4. PARALLEL EXECUTION
# --------------------------------------------------------------
max_workers = min(8, len(queries))
results: Dict[str, List[Dict[str, Any]]] = {}

print(f"Executing {len(queries)} queries in parallel (max {max_workers} workers)...")

with ThreadPoolExecutor(max_workers=max_workers) as executor:
    # Submit all queries
    future_to_name = {
        executor.submit(
            run_query,
            name,
            sql,
            {"site_id": SITE_ID}
        ): name
        for name, sql in queries.items()
    }

    # Collect results as they complete
    for future in as_completed(future_to_name):
        name = future_to_name[future]
        try:
            result_data = future.result()
            results[name] = result_data
            print(f"Completed: {name} → {len(result_data)} rows")
        except Exception as exc:
            results[name] = []
            print(f"Failed: {name} → {exc}")

# --------------------------------------------------------------
# 5. FINAL OUTPUT (Databricks-friendly)
# --------------------------------------------------------------
print("\nAll queries completed.")
print(f"Results dictionary keys: {list(results.keys())}")

# Example: Show first few rows of one table
sample_key = "site_account_mapping"
if results[sample_key]:
    print(f"\nSample from '{sample_key}':")
    for row in results[sample_key][:3]:
        print(row)
else:
    print(f"No data returned for '{sample_key}'")

# Optional: Display in notebook
try:
    display(results[sample_key][:10])
