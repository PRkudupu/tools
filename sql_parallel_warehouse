# 1) imports & simple config
from databricks.sdk import WorkspaceClient
from databricks.sdk.service.sql import StatementState
from concurrent.futures import ThreadPoolExecutor, as_completed
import os, time
from typing import Dict, Any, List, Tuple

# REQUIRED: set this to your warehouse id (or store in a secret/env var)
WAREHOUSE_ID = os.getenv("DATABRICKS_WAREHOUSE_ID") or "PUT-YOUR-WAREHOUSE-ID-HERE"
CATALOG = os.getenv("CATALOG", "industrial-data-science")
SCHEMA  = os.getenv("SCHEMA",  "cbt")

w = WorkspaceClient()  # uses notebook auth or DATABRICKS_HOST/TOKEN if provided

# 2) small helpers
def _wait(statement_id: str, interval: float = 0.25):
    h = w.statement_execution.get_statement(statement_id=statement_id)
    while h.status.state in (StatementState.PENDING, StatementState.RUNNING):
        time.sleep(interval)
        h = w.statement_execution.get_statement(statement_id=statement_id)
    return h

def _fetch_all(h) -> Tuple[List[str], List[List[Any]]]:
    cols = [c.name for c in (h.result.manifest.columns or [])]
    rows = h.result.data_array or []
    idx = 1
    while h.result and h.result.next_chunk_internal_link:
        chunk = w.statement_execution.get_statement_result_chunk_n(
            statement_id=h.statement_id, chunk_index=idx
        )
        rows.extend(chunk.data_array or [])
        idx += 1
    return cols, rows

def _run_one(name: str, sql_text: str, params: Dict[str, Any] | None = None):
    try:
        handle = w.statement_execution.execute_statement(
            warehouse_id=WAREHOUSE_ID,
            catalog=CATALOG,
            schema=SCHEMA,
            statement=sql_text,
            parameters=[{"name": k, "value": v} for k, v in (params or {}).items()],
            disposition="INLINE",
            wait_timeout="0s",
        )
        handle = _wait(handle.statement_id)
        if handle.status.state != StatementState.SUCCEEDED:
            return name, {"error": f"{handle.status.state}: {handle.status.error}"}
        cols, data = _fetch_all(handle)
        return name, [dict(zip(cols, r)) for r in data]
    except Exception as e:
        return name, {"error": str(e)}

# 3) public function you’ll call
def run_queries_in_parallel(queries: Dict[str, str], params: Dict[str, Any] | None = None, max_workers: int | None = None):
    if not WAREHOUSE_ID or WAREHOUSE_ID.startswith("PUT-"):
        raise ValueError("Set DATABRICKS_WAREHOUSE_ID to your SQL Warehouse id.")
    if max_workers is None:
        max_workers = min(8, len(queries))
    results: Dict[str, Any] = {}
    with ThreadPoolExecutor(max_workers=max_workers) as pool:
        futs = [pool.submit(_run_one, name, sql_text, params) for name, sql_text in queries.items()]
        for f in as_completed(futs):
            name, value = f.result()
            results[name] = value
    return results

# 4) example usage (adapt to your state dict)
site_id = "ABC123"
queries = {
    "site_account_mapping":  "SELECT * FROM cbt.site_account_mapping WHERE siteid = :site_id",
    "mpl_spl_penetration":   "SELECT * FROM cbt.mpl_spl_penetration  WHERE siteid = :site_id",
}
params = {"site_id": site_id}

data = run_queries_in_parallel(queries, params=params)
print({k: (len(v) if isinstance(v, list) else v) for k, v in data.items()})  # shows row counts per query
