<mxfile host="app.diagrams.net" modified="2026-06-26T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device">
  <diagram name="HTTP vs Azure Web PubSub" id="webpubsub-http-ai-chat">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="HTTP vs Azure Web PubSub for AI Chat / Long-Running Agent Workloads" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontStyle=1;fontSize=18;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1320" height="45" as="geometry"/></mxCell>
        <mxCell id="msg" value="Key message: Web PubSub does not make Databricks/Snowflake/LLM execution faster. It improves perceived latency, streaming, progress updates, and reduces polling while backend work runs asynchronously." style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=13;" parent="1" vertex="1"><mxGeometry x="70" y="80" width="1260" height="55" as="geometry"/></mxCell>
        <mxCell id="left_panel" value="NORMAL HTTP — Request / Response" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontStyle=1;fontSize=15;align=center;verticalAlign=top;spacingTop=12;fillColor=#FFF4D6;strokeColor=#D6A84F;" parent="1" vertex="1"><mxGeometry x="60" y="160" width="580" height="520" as="geometry"/></mxCell>
        <mxCell id="browser1" value="Browser / React UI" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;" parent="1" vertex="1"><mxGeometry x="100" y="235" width="140" height="55" as="geometry"/></mxCell>
        <mxCell id="api1" value="API Gateway / FastAPI" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#E5F3DF;strokeColor=#6AA84F;" parent="1" vertex="1"><mxGeometry x="450" y="235" width="140" height="55" as="geometry"/></mxCell>
        <mxCell id="work1" value="Synchronous backend processing&lt;br/&gt;RAG / SQL / Databricks / Snowflake / LLM / Agent" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FDE2E1;strokeColor=#D65A5A;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="380" y="340" width="220" height="95" as="geometry"/></mxCell>
        <mxCell id="wait1" value="User waits for complete response&lt;br/&gt;&lt;br/&gt;Blank spinner&lt;br/&gt;No live status&lt;br/&gt;Timeout risk" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FDE2E1;strokeColor=#D65A5A;" parent="1" vertex="1"><mxGeometry x="100" y="340" width="190" height="95" as="geometry"/></mxCell>
        <mxCell id="issues1" value="Problems with plain HTTP for AI workloads:&lt;br/&gt;• Browser waits until full answer is ready&lt;br/&gt;• Long RAG / SQL / LLM calls can hit API gateway or load balancer timeout&lt;br/&gt;• Progress updates require repeated polling&lt;br/&gt;• More API traffic under many users&lt;br/&gt;• Connection drop may lose response context" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=10;fillColor=#FDE2E1;strokeColor=#D65A5A;" parent="1" vertex="1"><mxGeometry x="100" y="470" width="500" height="130" as="geometry"/></mxCell>
        <mxCell id="result1" value="UX result: blank spinner → delayed full response → possible timeout" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FDE2E1;strokeColor=#D65A5A;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="100" y="620" width="500" height="35" as="geometry"/></mxCell>
        <mxCell id="right_panel" value="AZURE WEB PUBSUB — Persistent Real-Time Channel" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontStyle=1;fontSize=15;align=center;verticalAlign=top;spacingTop=12;fillColor=#E5F3DF;strokeColor=#6AA84F;" parent="1" vertex="1"><mxGeometry x="760" y="160" width="580" height="520" as="geometry"/></mxCell>
        <mxCell id="browser2" value="Browser / React UI" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;" parent="1" vertex="1"><mxGeometry x="800" y="230" width="130" height="55" as="geometry"/></mxCell>
        <mxCell id="pubsub" value="Azure Web PubSub&lt;br/&gt;(user/session group)" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#EADCF8;strokeColor=#9673A6;" parent="1" vertex="1"><mxGeometry x="980" y="230" width="150" height="55" as="geometry"/></mxCell>
        <mxCell id="api2" value="API Gateway / FastAPI" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#E5F3DF;strokeColor=#6AA84F;" parent="1" vertex="1"><mxGeometry x="1180" y="230" width="130" height="55" as="geometry"/></mxCell>
        <mxCell id="bus" value="Service Bus Queue" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;" parent="1" vertex="1"><mxGeometry x="990" y="350" width="130" height="55" as="geometry"/></mxCell>
        <mxCell id="agent" value="Agent / RAG / SQL / LLM Worker" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#E5F3DF;strokeColor=#6AA84F;" parent="1" vertex="1"><mxGeometry x="1170" y="350" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="tokens" value="Push status + tokens&lt;br/&gt;through Web PubSub" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#EADCF8;strokeColor=#9673A6;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="800" y="350" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="benefits" value="Benefits for this architecture:&lt;br/&gt;• Immediate 202 Accepted; backend continues async&lt;br/&gt;• Live LLM token streaming&lt;br/&gt;• Real-time status: planning, retrieving, querying, generating&lt;br/&gt;• No repeated browser polling&lt;br/&gt;• Web PubSub handles many concurrent WebSocket connections&lt;br/&gt;• Routes messages to correct user/session group" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=10;fillColor=#E5F3DF;strokeColor=#6AA84F;" parent="1" vertex="1"><mxGeometry x="800" y="465" width="500" height="135" as="geometry"/></mxCell>
        <mxCell id="result2" value="UX result: immediate acknowledgment → live progress → streaming answer → complete response" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#E5F3DF;strokeColor=#6AA84F;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="800" y="620" width="500" height="35" as="geometry"/></mxCell>
        <mxCell id="e1" value="1. POST /chat" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#D04A02;fontSize=11;" parent="1" edge="1" source="browser1" target="api1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="2. Wait until full response is ready" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#D04A02;fontSize=11;" parent="1" edge="1" source="api1" target="work1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="3. Full response only after processing" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#D04A02;fontSize=11;" parent="1" edge="1" source="work1" target="browser1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="405"/><mxPoint x="330" y="260"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="1. Open WebSocket / join session" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#6A329F;fontSize=11;" parent="1" edge="1" source="browser2" target="pubsub"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="2. POST /chat fire-and-forget" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#D04A02;fontSize=11;" parent="1" edge="1" source="browser2" target="api2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="310"/></Array></mxGeometry></mxCell>
        <mxCell id="e6" value="3. 202 Accepted immediately" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#38761D;fontSize=11;" parent="1" edge="1" source="api2" target="browser2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="315"/></Array></mxGeometry></mxCell>
        <mxCell id="e7" value="4. Enqueue work" style="endArrow=block;html=1;rounded=0;strokeWidth=2;dashed=1;fontSize=11;strokeColor=#D79B00;" parent="1" edge="1" source="api2" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="5. Worker consumes async" style="endArrow=block;html=1;rounded=0;strokeWidth=2;dashed=1;fontSize=11;strokeColor=#D79B00;" parent="1" edge="1" source="bus" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="6. Push progress/tokens to session" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#6A329F;fontSize=11;" parent="1" edge="1" source="agent" target="pubsub"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="450"/><mxPoint x="1050" y="450"/></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="7. Stream to browser" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#6A329F;fontSize=11;" parent="1" edge="1" source="pubsub" target="tokens"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="315"/><mxPoint x="875" y="315"/></Array></mxGeometry></mxCell>
        <mxCell id="table_header" value="Side-by-Side Architectural Comparison" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontStyle=1;fontSize=18;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1"><mxGeometry x="140" y="720" width="1120" height="35" as="geometry"/></mxCell>
        <mxCell id="h0" value="Dimension" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#F5F5F5;strokeColor=#999999;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="140" y="755" width="220" height="35" as="geometry"/></mxCell>
        <mxCell id="h1" value="Normal HTTP" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FDE2E1;strokeColor=#D65A5A;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="360" y="755" width="450" height="35" as="geometry"/></mxCell>
        <mxCell id="h2" value="Azure Web PubSub" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#E5F3DF;strokeColor=#6AA84F;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="810" y="755" width="450" height="35" as="geometry"/></mxCell>
        <mxCell id="d0" value="Connection model" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#F5F5F5;strokeColor=#999999;" parent="1" vertex="1"><mxGeometry x="140" y="790" width="220" height="35" as="geometry"/></mxCell>
        <mxCell id="n0" value="Short-lived request/response" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#CCCCCC;" parent="1" vertex="1"><mxGeometry x="360" y="790" width="450" height="35" as="geometry"/></mxCell>
        <mxCell id="w0" value="Persistent WebSocket channel managed by Azure Web PubSub" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#CCCCCC;" parent="1" vertex="1"><mxGeometry x="810" y="790" width="450" height="35" as="geometry"/></mxCell>
        <mxCell id="d1" value="Best fit" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#F5F5F5;strokeColor=#999999;" parent="1" vertex="1"><mxGeometry x="140" y="825" width="220" height="35" as="geometry"/></mxCell>
        <mxCell id="n1" value="Short API calls and simple CRUD" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#CCCCCC;" parent="1" vertex="1"><mxGeometry x="360" y="825" width="450" height="35" as="geometry"/></mxCell>
        <mxCell id="w1" value="Chat, agents, long-running reports, alerts, live updates" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#CCCCCC;" parent="1" vertex="1"><mxGeometry x="810" y="825" width="450" height="35" as="geometry"/></mxCell>
        <mxCell id="d2" value="User experience" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#F5F5F5;strokeColor=#999999;" parent="1" vertex="1"><mxGeometry x="140" y="860" width="220" height="35" as="geometry"/></mxCell>
        <mxCell id="n2" value="Waits for full response; blank spinner" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#CCCCCC;" parent="1" vertex="1"><mxGeometry x="360" y="860" width="450" height="35" as="geometry"/></mxCell>
        <mxCell id="w2" value="Receives live progress and token streaming" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#CCCCCC;" parent="1" vertex="1"><mxGeometry x="810" y="860" width="450" height="35" as="geometry"/></mxCell>
        <mxCell id="d3" value="Status updates" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#F5F5F5;strokeColor=#999999;" parent="1" vertex="1"><mxGeometry x="140" y="895" width="220" height="35" as="geometry"/></mxCell>
        <mxCell id="n3" value="Polling or refresh needed" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#CCCCCC;" parent="1" vertex="1"><mxGeometry x="360" y="895" width="450" height="35" as="geometry"/></mxCell>
        <mxCell id="w3" value="Backend pushes updates instantly" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#CCCCCC;" parent="1" vertex="1"><mxGeometry x="810" y="895" width="450" height="35" as="geometry"/></mxCell>
        <mxCell id="d4" value="Timeout risk" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#F5F5F5;strokeColor=#999999;" parent="1" vertex="1"><mxGeometry x="140" y="930" width="220" height="35" as="geometry"/></mxCell>
        <mxCell id="n4" value="Higher for long RAG / SQL / LLM workflows" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#CCCCCC;" parent="1" vertex="1"><mxGeometry x="360" y="930" width="450" height="35" as="geometry"/></mxCell>
        <mxCell id="w4" value="Lower because API can return 202 and process async" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#CCCCCC;" parent="1" vertex="1"><mxGeometry x="810" y="930" width="450" height="35" as="geometry"/></mxCell>
        <mxCell id="d5" value="Query speed" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#F5F5F5;strokeColor=#999999;" parent="1" vertex="1"><mxGeometry x="140" y="965" width="220" height="35" as="geometry"/></mxCell>
        <mxCell id="n5" value="Does not speed Databricks/Snowflake" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#CCCCCC;" parent="1" vertex="1"><mxGeometry x="360" y="965" width="450" height="35" as="geometry"/></mxCell>
        <mxCell id="w5" value="Also does not speed Databricks/Snowflake; improves delivery path" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#CCCCCC;" parent="1" vertex="1"><mxGeometry x="810" y="965" width="450" height="35" as="geometry"/></mxCell>
        <mxCell id="footer" value="Backend latency should be solved separately using caching, precomputed KPIs, materialized views, optimized Snowflake/Databricks queries, feature store, and proper warehouse/cluster sizing." style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacing=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="140" y="1010" width="1120" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
