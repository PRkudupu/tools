def extract_site_id(messages):
    # prefer number appearing after "site_id" or "site"
    for msg in reversed(messages):
        if msg.get("role") == "user":
            m = re.search(r'(?:site_id|site)\s*(\d+)|(\d+)', msg.get("content", ""))
            if m:
                return m.group(1) or m.group(2)
    return None

