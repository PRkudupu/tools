# ---- MLflow PythonModel wrapper ----
class CustBriefModel(PythonModel):
    def load_context(self, context):
        # load artifacts or setup once, if needed
        pass

    def predict(self, context, model_input: pd.DataFrame) -> pd.DataFrame:
        """
        Expects a DataFrame with a 'messages' column where each row is:
        [{"role": "...", "content": "..."}, ...]
        Returns a DataFrame with prompt_type, site_id, and result.
        """
        out_rows = []
        for _, row in model_input.iterrows():
            messages = row["messages"]
            state = {"messages": list(messages), "prompt_type": None}

            site_id = extract_site_id(state["messages"])
            if not site_id:
                state["prompt_type"] = "simple"
                result = build_graph(state, "simple")
                msg = "No site_id found"
            else:
                state["prompt_type"] = "rag"
                state["site_id"] = site_id
                result = build_graph(state, "llm")
                msg = f"Proceeding with site_id={state['site_id']}"

            out_rows.append({
                "prompt_type": state["prompt_type"],
                "site_id": state.get("site_id"),
                "result": result,         # can be dict/string—ensure your serving client can handle it
                "log": msg,
            })

        return pd.DataFrame(out_rows)
