class GraphPyfunc(PythonModel):
    def load_context(self, context):
        self.graph = build_graph()

    def predict(self, context, model_input):
        """
        Accepts a pandas DataFrame with columns:
        ['siteid', 'sf_json', 'analytics_json', 'user_input']
        """
        if isinstance(model_input, dict):
            model_input = pd.DataFrame([model_input])
        outs = []
        for _, row in model_input.iterrows():
            state = {
                "siteid": row.get("siteid"),
                "sf_json": row.get("sf_json", {}),
                "analytics_json": row.get("analytics_json", {}),
                "user_input": row.get("user_input"),
            }
            result = self.graph.invoke(state)
            outs.append({"output": result["messages"][-1]})
        return pd.DataFrame(outs)

