import mlflow
from mlflow.models import infer_signature
from graph_model import GraphPyfunc
import pandas as pd

# 2a) (only once per notebook/cluster) point registry to UC
mlflow.set_registry_uri("databricks-uc")

# 2b) sample row to record a signature
example = pd.DataFrame([{
    "siteid": "S-123",
    "sf_json": {"name": "Acme", "industry": "Retail"},
    "analytics_json": {"visits": 120, "trend": "up"},
    "user_input": "Focus on renewals and Q4 pipeline blockers."
}])

signature = infer_signature(
    example,
    pd.DataFrame([{"output": "text"}])
)

with mlflow.start_run() as run:
    mlflow.pyfunc.log_model(
        artifact_path="model",
        python_model=GraphPyfunc(),
        # If you need external libs, list them here:
        pip_requirements=[
            "mlflow>=2.11.0",
            "pandas",
            "langgraph",
            # "langchain-community",
            # "langchain-openai",
        ],
        signature=signature,
        input_example=example
    )
    run_id = run.info.run_id

# 2c) Register to UC (catalog.schema.model)
result = mlflow.register_model(
    model_uri=f"runs:/{run_id}/model",
    name="main.default.pre_call_brief_graph"  # change to your <catalog>.<schema>.<name>
)
print("Registered version:", result.version)

