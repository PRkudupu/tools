# ---- Credential guard (so failures are obvious at serve time) ----
def _require_dbx_creds():
    if not (
        os.environ.get("DATABRICKS_HOST")
        and os.environ.get("DATABRICKS_TOKEN")
    ) and not os.environ.get("DATABRICKS_CONFIG_PROFILE"):
        raise RuntimeError(
            "Databricks credentials not found. Set DATABRICKS_HOST and DATABRICKS_TOKEN "
            "(or DATABRICKS_CONFIG_PROFILE) in the serving environment."
        )


# ---- LangGraph state (NO Annotated) & helpers ----
class State(TypedDict):
    messages: List[BaseMessage]          # chat history as LangChain messages
    result: Optional[str]                # final answer text

def _to_messages(raw) -> List[BaseMessage]:
    """
    Normalize to List[BaseMessage].
    Accepts:
      - string: treated as a single human message
      - list of tuples: [(role, content)]
      - list of dicts: [{"role": "...", "content": "..."}]
      - already-constructed BaseMessage objects
    """
    if isinstance(raw, str):
        return [HumanMessage(content=raw)]

    out: List[BaseMessage] = []
    for m in raw or []:
        if isinstance(m, BaseMessage):
            out.append(m)
            continue

        if isinstance(m, tuple) and len(m) >= 2:
            role, content = str(m[0]).lower(), str(m[1])
        elif isinstance(m, dict) and "content" in m:
            role = str(m.get("role", m.get("type", "user"))).lower()
            content = str(m["content"])
        else:
            role = str(getattr(m, "role", getattr(m, "type", "user"))).lower()
            content = str(getattr(m, "content", m))

        if role in ("system",):
            out.append(SystemMessage(content=content))
        elif role in ("ai", "assistant"):
            out.append(AIMessage(content=content))
        else:
            out.append(HumanMessage(content=content))
    return out


# ---- Build LangGraph (kept tiny & robust) ----
def build_graph(endpoint: str):
    chat = ChatDatabricks(endpoint=endpoint, temperature=0.0, max_tokens=256)

    def llm_call(state: State) -> State:
        # Convert whatever came in to BaseMessage list
        msgs: List[BaseMessage] = _to_messages(state.get("messages", []))

        # Ensure first is a system message (prepend locally; we are NOT mutating the channel)
        if not msgs or not isinstance(msgs[0], SystemMessage):
            msgs = [SystemMessage(content="You are a helpful assistant.")] + msgs

        # Call the Databricks chat endpoint
        ai = chat.invoke(msgs)
        text = getattr(ai, "content", str(ai))

        # Return ONLY the *new* AI message; the reducer will append it to the channel
        return {"messages": [AIMessage(content=text)], "result": text}

    # Map the messages reducer explicitly (this is the key change vs Annotated)
    g = StateGraph(State, channels={"messages": add_messages})
    g.add_node("llm_call", llm_call)
    g.add_edge(START, "llm_call")
    g.add_edge("llm_call", END)
    return g.compile()


# ---- MLflow pyfunc wrapper (lazy-init + cred check) ----
class LangGraphPyfunc(mlflow.pyfunc.PythonModel):
    def __init__(self, endpoint_name: str):
        self.endpoint_name = endpoint_name
        self.graph = None  # compiled graph

    def load_context(self, context):
        _require_dbx_creds()
        self.graph = build_graph(self.endpoint_name)

    def predict(self, context, model_input: pd.DataFrame) -> pd.DataFrame:
        # Lazy init for notebook tests where load_context may not run
        if self.graph is None:
            _require_dbx_creds()
            self.graph = build_graph(self.endpoint_name)

        results: List[str] = []
        for msgs in model_input["messages"]:
            # Normalize to BaseMessage for the graph
            in_state: State = {"messages": _to_messages(msgs), "result": None}
            out_state = self.graph.invoke(in_state)
            results.append(out_state["result"])
        return pd.DataFrame({"result": results})


