        </mxCell>
        <mxCell id="n2" value="Waits for full response; blank spinner" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="370" y="870" width="470" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="w2" value="Receives live progress and token streaming" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="840" y="870" width="520" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="Status updates" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="140" y="905" width="230" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="Polling or page refresh needed" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="370" y="905" width="470" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="w3" value="Backend pushes updates instantly" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
