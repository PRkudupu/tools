<mxfile host="app.diagrams.net" modified="2026-06-26T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device">
  <diagram name="HTTP vs Azure Web PubSub" id="lucid-safe-webpubsub">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="HTTP vs Azure Web PubSub for AI Chat and Long-Running Agent Workloads" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;fontSize=18;align=center;verticalAlign=middle;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1420" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="msg" value="Key message: Web PubSub does not make Databricks, Snowflake, or LLM execution faster. It improves perceived latency by streaming responses, showing live progress, reducing polling, and allowing backend work to run asynchronously." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#111111;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="80" width="1360" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="left_panel" value="NORMAL HTTP - REQUEST / RESPONSE" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF4D6;strokeColor=#D6A84F;strokeWidth=1;fontSize=15;align=center;verticalAlign=top;fontColor=#111111;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="170" width="640" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="browser_http" value="Browser / React UI" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="110" y="245" width="150" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="api_http" value="API Gateway / FastAPI" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3DF;strokeColor=#6AA84F;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="500" y="245" width="150" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="wait_http" value="User waits for full response&#10;Blank spinner&#10;No live status&#10;Timeout risk" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FDE2E1;strokeColor=#D65A5A;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="110" y="350" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="backend_http" value="Synchronous backend processing&#10;RAG / SQL / Databricks / Snowflake / LLM / Agent" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FDE2E1;strokeColor=#D65A5A;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="425" y="350" width="230" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="issues_http" value="Problems with plain HTTP for AI workloads:&#10;- Browser waits until full answer is ready&#10;- Long RAG / SQL / LLM calls may hit gateway or load balancer timeout&#10;- Progress updates require repeated polling&#10;- More API traffic under many users&#10;- Connection drop may lose response context" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FDE2E1;strokeColor=#D65A5A;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="110" y="485" width="545" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="result_http" value="UX result: blank spinner -&gt; delayed full response -&gt; possible timeout" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FDE2E1;strokeColor=#D65A5A;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="110" y="630" width="545" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="right_panel" value="AZURE WEB PUBSUB - PERSISTENT REAL-TIME CHANNEL" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3DF;strokeColor=#6AA84F;strokeWidth=1;fontSize=15;align=center;verticalAlign=top;fontColor=#111111;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="790" y="170" width="640" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="browser_ws" value="Browser / React UI" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="830" y="240" width="140" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="pubsub" value="Azure Web PubSub&#10;User / session group" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EADCF8;strokeColor=#9673A6;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="1030" y="240" width="160" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="api_ws" value="API Gateway / FastAPI" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3DF;strokeColor=#6AA84F;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="1250" y="240" width="140" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="tokens_ws" value="Live status and token stream&#10;received by browser" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EADCF8;strokeColor=#9673A6;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="830" y="365" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="bus" value="Service Bus Queue" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="1040" y="365" width="150" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="worker" value="Agent / RAG / SQL / LLM Worker" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3DF;strokeColor=#6AA84F;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="1240" y="360" width="160" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="benefits_ws" value="Benefits for this architecture:&#10;- API returns 202 Accepted quickly while backend continues async&#10;- Live LLM token streaming&#10;- Real-time status: planning, retrieving, querying, generating&#10;- No repeated browser polling&#10;- Web PubSub manages many concurrent WebSocket connections&#10;- Routes messages to the correct user or session group" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3DF;strokeColor=#6AA84F;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="830" y="485" width="560" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="result_ws" value="UX result: immediate acknowledgment -&gt; live progress -&gt; streaming answer -&gt; complete response" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E5F3DF;strokeColor=#6AA84F;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="830" y="630" width="560" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="1. POST /chat" style="endArrow=block;html=0;rounded=0;strokeWidth=2;strokeColor=#D04A02;fontSize=11;" parent="1" edge="1" source="browser_http" target="api_http">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="2. Backend waits for complete processing" style="endArrow=block;html=0;rounded=0;strokeWidth=2;strokeColor=#D04A02;fontSize=11;" parent="1" edge="1" source="api_http" target="backend_http">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="3. Full response returns only after processing" style="endArrow=block;html=0;rounded=0;strokeWidth=2;strokeColor=#D04A02;fontSize=11;" parent="1" edge="1" source="backend_http" target="browser_http">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="365" y="415"/>
              <mxPoint x="365" y="270"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="1. Open WebSocket and join session" style="endArrow=block;html=0;rounded=0;strokeWidth=2;strokeColor=#6A329F;fontSize=11;" parent="1" edge="1" source="browser_ws" target="pubsub">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="2. POST /chat fire-and-forget" style="endArrow=block;html=0;rounded=0;strokeWidth=2;strokeColor=#D04A02;fontSize=11;" parent="1" edge="1" source="browser_ws" target="api_ws">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1030" y="320"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" value="3. 202 Accepted immediately" style="endArrow=block;html=0;rounded=0;strokeWidth=2;strokeColor=#38761D;fontSize=11;" parent="1" edge="1" source="api_ws" target="browser_ws">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1110" y="330"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="4. Enqueue work" style="endArrow=block;html=0;rounded=0;strokeWidth=2;strokeColor=#D79B00;fontSize=11;dashed=1;" parent="1" edge="1" source="api_ws" target="bus">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="5. Worker consumes async" style="endArrow=block;html=0;rounded=0;strokeWidth=2;strokeColor=#D79B00;fontSize=11;dashed=1;" parent="1" edge="1" source="bus" target="worker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="6. Push progress and tokens to session" style="endArrow=block;html=0;rounded=0;strokeWidth=2;strokeColor=#6A329F;fontSize=11;" parent="1" edge="1" source="worker" target="pubsub">
          <mxGeometry relative="1" as="geometry">
