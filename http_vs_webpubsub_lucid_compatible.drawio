            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" value="7. Stream updates to browser" style="endArrow=block;html=0;rounded=0;strokeWidth=2;strokeColor=#6A329F;fontSize=11;" parent="1" edge="1" source="pubsub" target="tokens_ws">
          <mxGeometry relative="1" as="geometry">
