        </mxCell>
        <mxCell id="d4" value="Timeout risk" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="140" y="940" width="230" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="Higher for long RAG / SQL / LLM workflows" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="370" y="940" width="470" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="w4" value="Lower because API can return 202 and process async" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="840" y="940" width="520" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="d5" value="Query speed" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="140" y="975" width="230" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="Does not speed Databricks or Snowflake" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="370" y="975" width="470" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="w5" value="Also does not speed Databricks or Snowflake; improves delivery path" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCCCCC;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#111111;" parent="1" vertex="1">
          <mxGeometry x="840" y="975" width="520" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="footer" value="Backend latency must be solved separately using caching, precomputed KPIs, materialized views, optimized Snowflake/Databricks queries, feature store, and proper warehouse or cluster sizing." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#111111;fontStyle=1;" parent="1" vertex="1">
