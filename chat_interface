<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Databricks RAG Chat Interface</title>
  <style>
    body {
      font-family: sans-serif;
      background: #FFFFFF;
      margin: 0;
      padding: 10px;
      color: #000;
    }
    .banner {
      width: 100%;
      padding: 10px;
      background-color: #ffffff;
      border-bottom: 1px solid #ccc;
      text-align: center;
    }
    .banner img {
      max-height: 40px;
    }
    .chat-history {
      border: 1px solid #ccc;
      background: #F0F8FF;
      border-radius: 5px;
      padding: 10px;
      height: 400px;
      overflow-y: auto;
      margin-bottom: 10px;
    }
    .message {
      max-width: 70%;
      padding: 8px 12px;
      margin: 5px 0;
      border-radius: 5px;
      line-height: 1.4;
    }
    .message.user {
      background-color: #006BD3;
      color: #fff;
      margin-left: auto;
      text-align: left;
    }
    .message.bot {
      background-color: #e9e9e9;
      color: #000;
      margin-right: auto;
      text-align: left;
    }
    .input-area {
      display: flex;
      align-items: center;
    }
    .input-area input {
      flex: 1;
      padding: 8px;
      font-size: 1em;
      border: 1px solid #ccc;
      border-radius: 3px;
    }
    .input-area button {
      padding: 8px 15px;
      margin-left: 5px;
      font-size: 1em;
      background-color: #006BD3;
      color: #fff;
      border: none;
      border-radius: 3px;
      cursor: pointer;
    }
    .input-area button:hover {
      background-color: #005bb5;
    }
  </style>
</head>
<body>
  <div class="banner">
    <img src="/mnt/data/6b3e6d7a-316f-4f1a-8958-ad694b2c48e1.png" alt="My Ecolab Banner" />
  </div>
  <div id="chat" class="chat-history"></div>
  <div class="input-area">
    <input id="user-input" type="text" placeholder="Type your message..." />
    <button id="send-btn">Send</button>
  </div>
  <script>
    const chatHistory = document.getElementById('chat');
    const userInput = document.getElementById('user-input');
    const sendBtn = document.getElementById('send-btn');

    // Hardcoded Databricks token
    const apiToken = "dapic6854bd4f0c39e91b51b99a2edfd86f1..."; // REPLACE with full valid PAT

    sendBtn.addEventListener('click', sendMessage);
    userInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        sendMessage();
      }
    });

    function sendMessage() {
      const messageText = userInput.value.trim();
      if (!apiToken) {
        alert("API token not set.");
        return;
      }
      if (messageText === "") return;

      appendMessage(messageText, "user");
      userInput.value = "";

      const payload = {
        "dataframe_split": {
          "columns": ["site_id", "sf_feed", "analytic_data", "messages"],
          "data": [
            [8391413, "", "", [{ role: "user", content: messageText }]]
          ]
        }
      };

      fetch("https://adb-1355704782079007.7.azuredatabricks.net/serving-endpoints/cbt_1/invocations", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${apiToken}`
        },
        body: JSON.stringify(payload)
      })
      .then(response => {
        if (!response.ok) throw new Error("Request failed: " + response.status);
        return response.json();
      })
      .then(data => {
        let replyText = "";
        if (data && data.choices && data.choices.length > 0) {
          replyText = data.choices[0].message.content;
        } else {
          replyText = JSON.stringify(data);
        }
        appendMessage(replyText, "bot");
      })
      .catch(error => {
        console.error("Error during fetch:", error);
        appendMessage("Error: " + error.message, "bot");
      });
    }

    function appendMessage(text, sender) {
      const msgDiv = document.createElement('div');
      msgDiv.className = "message " + (sender === "user" ? "user" : "bot");
      msgDiv.textContent = text;
      chatHistory.appendChild(msgDiv);
      chatHistory.scrollTop = chatHistory.scrollHeight;
    }
  </script>
</body>
</html>
