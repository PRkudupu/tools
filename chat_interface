<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Databricks RAG Chat Interface</title>
  <style>
    /* Ecolab blue/white color theme (#006BD3) applied for accents */
    body {
      font-family: sans-serif;
      background: #FFFFFF;
      margin: 0;
      padding: 10px;
      color: #000;
    }
    .token-area {
      margin-bottom: 10px;
    }
    .token-area label {
      font-weight: bold;
      margin-right: 5px;
    }
    .token-area input {
      padding: 5px;
      width: 300px;
    }
    .token-area button {
      padding: 5px 10px;
      background-color: #006BD3;
      color: #fff;
      border: none;
      border-radius: 3px;
      cursor: pointer;
    }
    .token-area button:hover {
      background-color: #005bb5; /* slightly darker on hover */
    }

    .chat-history {
      border: 1px solid #ccc;
      background: #F0F8FF;  /* very light blue background for chat area */
      border-radius: 5px;
      padding: 10px;
      height: 400px;
      overflow-y: auto;
      margin-bottom: 10px;
    }
    .message {
      max-width: 70%;
      padding: 8px 12px;
      margin: 5px 0;
      border-radius: 5px;
      line-height: 1.4;
    }
    .message.user {
      background-color: #006BD3; /* Ecolab blue for user messages */
      color: #fff;
      margin-left: auto;        /* align user messages to the right */
      text-align: left;
    }
    .message.bot {
      background-color: #e9e9e9; /* light gray for bot messages (on white background) */
      color: #000;
      margin-right: auto;       /* align bot messages to the left */
      text-align: left;
    }

    .input-area {
      display: flex;
      align-items: center;
    }
    .input-area input {
      flex: 1;
      padding: 8px;
      font-size: 1em;
      border: 1px solid #ccc;
      border-radius: 3px;
    }
    .input-area button {
      padding: 8px 15px;
      margin-left: 5px;
      font-size: 1em;
      background-color: #006BD3;
      color: #fff;
      border: none;
      border-radius: 3px;
      cursor: pointer;
    }
    .input-area button:hover {
      background-color: #005bb5;
    }
  </style>
</head>
<body>

  <!-- Token Input Area -->
  <div class="token-area">
    <label for="token">API Token:</label>
    <input id="token" type="password" placeholder="Enter Databricks PAT" />
    <button id="set-token">Set Token</button>
  </div>

  <!-- Chat History Area -->
  <div id="chat" class="chat-history">
    <!-- Messages will appear here -->
  </div>

  <!-- User Input Area -->
  <div class="input-area">
    <input id="user-input" type="text" placeholder="Type your message..." />
    <button id="send-btn">Send</button>
  </div>

  <script>
    const chatHistory = document.getElementById('chat');
    const userInput = document.getElementById('user-input');
    const sendBtn = document.getElementById('send-btn');
    const tokenInput = document.getElementById('token');
    const setTokenBtn = document.getElementById('set-token');

    let apiToken = "";  // will hold the Databricks PAT after setting

    // Handle setting the API token
    setTokenBtn.addEventListener('click', () => {
      const tokenVal = tokenInput.value.trim();
      if (tokenVal !== "") {
        apiToken = tokenVal;
        alert("API token set. You can now send messages.");
        // Optionally, disable token input after setting (to prevent accidental change)
        // tokenInput.disabled = true;
      } else {
        alert("Please enter a valid token.");
      }
    });

    // Send message on button click
    sendBtn.addEventListener('click', sendMessage);
    // Also allow pressing Enter to send the message
    userInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        sendMessage();
      }
    });

    function sendMessage() {
      const messageText = userInput.value.trim();
      if (!apiToken) {
        alert("Please set your API token before sending a message.");
        return;
      }
      if (messageText === "") {
        return;  // do nothing if input is empty
      }

      // Append user's message to the chat history
      appendMessage(messageText, "user");
      userInput.value = "";  // clear input field

      // Prepare the payload for Databricks RAG endpoint
      const payload = {
        messages: [{ role: "user", content: messageText }],
        stream: false  // get full response in one chunk (no streaming)
      };

      // Send POST request to the Databricks serving endpoint
      fetch("https://adb-1355704782079007.7.azuredatabricks.net/serving-endpoints/customer_pre_brief/invocations", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${apiToken}`
        },
        body: JSON.stringify(payload)
      })
      .then(response => {
        if (!response.ok) {
          // If the server returns an error status, throw to catch block
          throw new Error("Request failed: " + response.status + " " + response.statusText);
        }
        return response.json();
      })
      .then(data => {
        console.log("Response data:", data);  // for debugging (optional)
        let replyText = "";
        if (data && data.choices && data.choices.length > 0) {
          // Extract the assistant's reply content from the first choice
          replyText = data.choices[0].message.content;
        } else if (data && data.messages) {
          // Some endpoints might return a messages array with the assistant response
          const assistantMsg = data.messages.find(m => m.role === "assistant");
          replyText = assistantMsg ? assistantMsg.content : "";
        } else {
          // Fallback: if format is unexpected, show entire JSON as string
          replyText = JSON.stringify(data);
        }
        // Append assistant's reply to the chat
        appendMessage(replyText, "bot");
      })
      .catch(error => {
        console.error("Error during fetch:", error);
        // Display error message in chat
        appendMessage("Error: " + error.message, "bot");
      });
    }

    // Helper function to append a message to the chat history
    function appendMessage(text, sender) {
      const msgDiv = document.createElement('div');
      msgDiv.className = "message " + (sender === "user" ? "user" : "bot");
      msgDiv.textContent = text;
      chatHistory.appendChild(msgDiv);
      chatHistory.scrollTop = chatHistory.scrollHeight;  // auto-scroll to bottom
    }
  </script>

</body>
</html>
