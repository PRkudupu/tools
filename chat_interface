<script>
  const chatHistory = document.getElementById("chat");
  const userInput = document.getElementById("user-input");
  const sendBtn = document.getElementById("send-btn");

  sendBtn.addEventListener("click", sendMessage);
  userInput.addEventListener("keydown", function (e) {
    if (e.key === "Enter") {
      e.preventDefault();
      sendMessage();
    }
  });

  function sendMessage() {
    const messageText = userInput.value.trim();
    if (messageText === "") return;

    appendMessage(messageText, "user");
    userInput.value = "";

    // DEBUG marker
    console.log("➡️ Sending message to proxy:", messageText);

    const payload = {
      dataframe_split: {
        columns: ["site_id", "sf_feed", "analytic_data", "messages"],
        data: [
          [
            8391413, // site_id
            "",      // sf_feed
            "",      // analytic_data
            [
              {
                role: "user",
                content: messageText
              }
            ]
          ]
        ]
      }
    };

    fetch("http://localhost:3000/chat", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify(payload)
    })
      .then((response) => {
        console.log("⬅️ Proxy response status:", response.status);
        if (!response.ok) {
          // Still try to read body so we can show Databricks error text
          return response.text().then((text) => {
            throw new Error("HTTP " + response.status + ": " + text);
          });
        }
        return response.json();
      })
      .then((data) => {
        console.log("⬅️ Proxy JSON:", data);

        let replyText = "";

        // Adjust based on your endpoint’s actual response schema
        if (data && data.choices && data.choices.length > 0) {
          replyText = data.choices[0].message.content;
        } else if (data && data.messages) {
          const assistantMsg = data.messages.find(
            (m) => m.role === "assistant"
          );
          replyText = assistantMsg ? assistantMsg.content : JSON.stringify(data);
        } else {
          replyText = JSON.stringify(data);
        }

        appendMessage(replyText, "bot");
      })
      .catch((error) => {
        console.error("❌ Fetch error:", error);
        appendMessage("Error from server: " + error.message, "bot");
      });
  }

  function appendMessage(text, sender) {
    const msgDiv = document.createElement("div");
    msgDiv.className = "message " + (sender === "user" ? "user" : "bot");
    msgDiv.textContent = text;
    chatHistory.appendChild(msgDiv);
    chatHistory.scrollTop = chatHistory.scrollHeight;
  }
</script>
