<mxfile host="app.diagrams.net">
  <diagram name="Agent Sequence Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageWidth="1800" pageHeight="1200">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Swimlanes -->
        <mxCell id="user" value="User / Frontend" style="swimlane;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="160" height="1000" as="geometry"/>
        </mxCell>

        <mxCell id="planner" value="Planner Agent" style="swimlane;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="180" height="1000" as="geometry"/>
        </mxCell>

        <mxCell id="cache" value="Conversation Cache" style="swimlane;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="160" height="1000" as="geometry"/>
        </mxCell>

        <mxCell id="llm" value="LLM" style="swimlane;" vertex="1" parent="1">
          <mxGeometry x="520" y="20" width="160" height="1000" as="geometry"/>
        </mxCell>

        <mxCell id="sub" value="Sub-Agent" style="swimlane;" vertex="1" parent="1">
          <mxGeometry x="680" y="20" width="160" height="1000" as="geometry"/>
        </mxCell>

        <mxCell id="sn" value="ServiceNow" style="swimlane;" vertex="1" parent="1">
          <mxGeometry x="840" y="20" width="160" height="1000" as="geometry"/>
        </mxCell>

        <mxCell id="gws" value="GWS" style="swimlane;" vertex="1" parent="1">
          <mxGeometry x="1000" y="20" width="160" height="1000" as="geometry"/>
        </mxCell>

        <mxCell id="wh" value="Webhook" style="swimlane;" vertex="1" parent="1">
          <mxGeometry x="1160" y="20" width="160" height="1000" as="geometry"/>
        </mxCell>

        <!-- Edges with Y positions -->

        <mxCell style="endArrow=block;" edge="1" parent="1" source="user" target="planner">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="80" as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell value="Fetch history" style="endArrow=block;" edge="1" parent="1" source="planner" target="cache">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="140" as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell value="Context" style="endArrow=block;" edge="1" parent="1" source="cache" target="planner">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="180" as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell value="Prompt" style="endArrow=block;" edge="1" parent="1" source="planner" target="llm">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="240" as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell value="Decision" style="endArrow=block;" edge="1" parent="1" source="llm" target="planner">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="280" as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell value="Process request" style="endArrow=block;" edge="1" parent="1" source="planner" target="sub">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="340" as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell value="API call" style="endArrow=block;" edge="1" parent="1" source="sub" target="sn">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="380" as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell value="Response" style="endArrow=block;" edge="1" parent="1" source="sn" target="sub">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="420" as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell value="Formatted" style="endArrow=block;" edge="1" parent="1" source="sub" target="planner">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="460" as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell value="Stream response" style="endArrow=block;" edge="1" parent="1" source="planner" target="user">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="500" as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell value="Async request" style="endArrow=block;" edge="1" parent="1" source="planner" target="sn">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="580" as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell value="Ack" style="endArrow=block;" edge="1" parent="1" source="sn" target="planner">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="620" as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell value="Searching..." style="endArrow=block;" edge="1" parent="1" source="planner" target="user">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="660" as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell value="Callback" style="endArrow=block;" edge="1" parent="1" source="sn" target="wh">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="720" as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell value="Forward" style="endArrow=block;" edge="1" parent="1" source="wh" target="planner">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="760" as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell value="Final response" style="endArrow=block;" edge="1" parent="1" source="planner" target="user">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="800" as="offset"/>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
